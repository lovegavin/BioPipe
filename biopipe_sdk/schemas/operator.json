{
  "additionalProperties": false,
  "description": "Canonical, versioned extension declaration; UI projections are separate.",
  "properties": {
    "protocol_version": {
      "const": 2,
      "default": 2,
      "title": "Protocol Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "kind": {
      "enum": [
        "operator",
        "reader"
      ],
      "title": "Kind",
      "type": "string"
    },
    "entry_point": {
      "title": "Entry Point",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Operator library category, independent of package origin. Custom labels are allowed.",
      "title": "Category"
    },
    "icon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional module-relative image path or Studio icon name. Missing or unknown names use the category default.",
      "title": "Icon"
    },
    "icon_image": {
      "anyOf": [
        {
          "pattern": "^data:image/(png|jpeg|webp|gif|svg\\+xml);base64,[A-Za-z0-9+/]+={0,2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SDK-generated portable image data; authors declare a relative path in icon.",
      "title": "Icon Image"
    },
    "parameters_schema": {
      "additionalProperties": true,
      "title": "Parameters Schema",
      "type": "object"
    },
    "contracts": {
      "additionalProperties": true,
      "title": "Contracts",
      "type": "object"
    },
    "resources": {
      "additionalProperties": true,
      "title": "Resources",
      "type": "object"
    },
    "dependencies": {
      "description": "PEP 508 dependencies; compatible versions share the host runtime, conflicting versions use a private dependency directory and subprocess with the same Python.",
      "items": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "dependency_imports": {
      "description": "Optional import smoke checks, run outside the UI process.",
      "items": {
        "type": "string"
      },
      "title": "Dependency Imports",
      "type": "array"
    },
    "inputs_arity": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": "*",
          "type": "string"
        }
      ],
      "default": 0,
      "title": "Inputs Arity"
    },
    "outputs": {
      "items": {
        "type": "string"
      },
      "title": "Outputs",
      "type": "array"
    },
    "output_parameter": {
      "anyOf": [
        {
          "const": "output",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Parameter"
    },
    "extensions": {
      "items": {
        "type": "string"
      },
      "title": "Extensions",
      "type": "array"
    },
    "requires_siblings": {
      "items": {
        "type": "string"
      },
      "title": "Requires Siblings",
      "type": "array"
    },
    "excludes_siblings": {
      "items": {
        "type": "string"
      },
      "title": "Excludes Siblings",
      "type": "array"
    },
    "handles_compression": {
      "default": false,
      "title": "Handles Compression",
      "type": "boolean"
    },
    "file_input": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Input"
    },
    "preview": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview"
    },
    "title_aliases": {
      "items": {
        "type": "string"
      },
      "title": "Title Aliases",
      "type": "array"
    },
    "title_parameter": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title Parameter"
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "entry_point",
    "title",
    "parameters_schema",
    "contracts",
    "resources"
  ],
  "title": "Descriptor",
  "type": "object"
}
