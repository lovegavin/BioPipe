{
  "additionalProperties": true,
  "properties": {
    "protocol_version": {
      "const": 1,
      "default": 1,
      "title": "Protocol Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "kind": {
      "enum": [
        "operator",
        "reader"
      ],
      "title": "Kind",
      "type": "string"
    },
    "entry_point": {
      "title": "Entry Point",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Operator library category, independent of package origin. Custom labels are allowed.",
      "title": "Category"
    },
    "icon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional Studio icon name. Missing or unknown names use the default icon.",
      "title": "Icon"
    },
    "parameters_schema": {
      "additionalProperties": true,
      "title": "Parameters Schema",
      "type": "object"
    },
    "contracts": {
      "additionalProperties": true,
      "title": "Contracts",
      "type": "object"
    },
    "resources": {
      "additionalProperties": true,
      "title": "Resources",
      "type": "object"
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "entry_point",
    "title",
    "parameters_schema",
    "contracts",
    "resources"
  ],
  "title": "Descriptor",
  "type": "object"
}
