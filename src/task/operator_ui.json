{
  "missing": {
    "title": "缺失值过滤",
    "category": "质量控制",
    "description": "按指定维度过滤缺失比例过高的样本或特征。",
    "icon": "Funnel",
    "parameters": [
      {
        "key": "dim",
        "label": "过滤维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "threshold",
        "label": "最大缺失比例",
        "type": "number",
        "default": 0.05,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "required": true
      }
    ]
  },
  "maf": {
    "title": "MAF",
    "title_aliases": [
      "等位基因频率"
    ],
    "category": "质量控制",
    "description": "过滤低频变异。输入需要基因型及 ploidy 元数据。",
    "icon": "Dna",
    "parameters": [
      {
        "key": "dim",
        "label": "变异维度",
        "type": "string",
        "default": "variant",
        "required": true
      },
      {
        "key": "threshold",
        "label": "最低 MAF",
        "type": "number",
        "default": 0.05,
        "min": 0,
        "max": 0.5,
        "step": 0.01
      }
    ]
  },
  "hwe": {
    "title": "HWE",
    "title_aliases": [
      "平衡检验"
    ],
    "category": "质量控制",
    "description": "Hardy–Weinberg 平衡过滤。输入需要二倍体基因型。",
    "icon": "Scales",
    "parameters": [
      {
        "key": "dim",
        "label": "变异维度",
        "type": "string",
        "default": "variant",
        "required": true
      },
      {
        "key": "threshold",
        "label": "最低 P 值",
        "type": "number",
        "default": 0.0001,
        "min": 0,
        "max": 1,
        "step": 0.0001
      }
    ]
  },
  "ld_prune": {
    "title": "LD pruning",
    "title_aliases": [
      "连锁不平衡剪枝"
    ],
    "category": "质量控制",
    "description": "在滑动窗口内移除高度相关的变异。",
    "icon": "Intersect",
    "parameters": [
      {
        "key": "dim",
        "label": "变异维度",
        "type": "string",
        "default": "variant",
        "required": true
      },
      {
        "key": "window",
        "label": "窗口大小",
        "type": "integer",
        "default": 50,
        "min": 1
      },
      {
        "key": "r2",
        "label": "R² 阈值",
        "type": "number",
        "default": 0.2,
        "min": 0,
        "max": 1,
        "step": 0.05
      }
    ]
  },
  "pca": {
    "title": "PCA",
    "title_aliases": [
      "主成分分析"
    ],
    "category": "统计分析",
    "description": "标准化数据，提取主成分；缺失值以特征均值填充。",
    "icon": "ChartScatter",
    "output_type": "Scores",
    "parameters": [
      {
        "key": "dim",
        "label": "压缩维度",
        "type": "string",
        "default": "feature",
