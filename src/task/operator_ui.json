        "label": "主成分数量",
        "type": "integer",
        "default": 2,
        "min": 1,
        "required": true
      }
    ]
  },
  "regress": {
    "title": "回归分析",
    "category": "统计分析",
    "description": "逐个特征拟合回归模型，可加入协变量。",
    "icon": "TrendUp",
    "output_type": "Association",
    "parameters": [
      {
        "key": "dim",
        "label": "特征维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "response",
        "label": "响应变量标签",
        "type": "string",
        "default": "trait",
        "required": true
      },
      {
        "key": "covariates",
        "label": "协变量标签",
        "type": "list",
        "default": []
      },
      {
        "key": "method",
        "label": "模型",
        "type": "choice",
        "default": "auto",
        "options": [
          "auto",
          "ols",
          "logit"
        ]
      }
    ]
  },
  "correction": {
    "title": "FDR",
    "title_aliases": [
      "多重检验校正"
    ],
    "title_parameter": {
      "key": "method",
      "values": {
        "fdr": "FDR",
        "bonferroni": "Bonferroni"
      }
    },
    "category": "统计分析",
    "description": "进行 Bonferroni 或 FDR 校正。",
    "icon": "CheckSquare",
    "output_type": "Association",
    "parameters": [
      {
        "key": "method",
        "label": "校正方法",
        "type": "choice",
        "default": "fdr",
        "options": [
          "fdr",
          "bonferroni"
        ]
      },
      {
        "key": "alpha",
        "label": "显著性水平",
        "type": "number",
        "default": 0.05,
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "key": "pfield",
        "label": "P 值标签",
        "type": "string",
        "default": "P"
      },
      {
        "key": "dim",
        "label": "统计量维度",
        "type": "string",
        "default": "statistic"
      }
    ]
  },
  "describe": {
    "title": "数据概览",
    "category": "数据整理",
    "description": "查看形状、标签、缺失情况与全局统计。支持分块读取。",
    "icon": "ListBullets",
    "output_type": "Report",
    "parameters": []
