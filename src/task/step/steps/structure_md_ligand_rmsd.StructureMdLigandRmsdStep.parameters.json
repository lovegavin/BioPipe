{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "MD 配体位移 RMSD 参数",
  "properties": {
    "trajectory_path": {
      "title": "轨迹文件 (.npy, nm)",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "topology_path": {
      "title": "拓扑 PDB（含配体）",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "receptor_chains": {
      "title": "受体链（逗号分隔）",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "ligand_resname": {
      "title": "配体残基名",
      "type": "string",
      "default": "LIG",
      "x-ui-group": "输入",
      "x-ui-order": 4
    },
    "stride": {
      "title": "采样间隔（帧）",
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 100,
      "x-ui-group": "采样",
      "x-ui-order": 5
    },
    "frame_dim": {
      "title": "输出维度名",
      "type": "string",
      "default": "frame",
      "x-ui-group": "输出",
      "x-ui-order": 6
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "ligand_rmsd",
      "x-ui-group": "输出",
      "x-ui-order": 7
    }
  }
}
