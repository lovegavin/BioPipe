{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "MD 盐桥占有率参数",
  "properties": {
    "trajectory_path": {
      "title": "轨迹文件 (.npy, nm)",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "topology_path": {
      "title": "拓扑 PDB",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "chains": {
      "title": "链过滤（逗号分隔）",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "cutoff": {
      "title": "盐桥距离 (Å)",
      "type": "number",
      "default": 4.0,
      "minimum": 2.0,
      "maximum": 8.0,
      "x-ui-group": "几何",
      "x-ui-order": 4
    },
    "min_occupancy": {
      "title": "最小占有率",
      "type": "number",
      "default": 0.2,
      "minimum": 0.0,
      "maximum": 1.0,
      "x-ui-group": "几何",
      "x-ui-order": 5
    },
    "stride": {
      "title": "采样间隔（帧）",
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 100,
      "x-ui-group": "采样",
      "x-ui-order": 6
    },
    "bond_dim": {
      "title": "输出维度名",
      "type": "string",
      "default": "salt_bridge",
      "x-ui-group": "输出",
      "x-ui-order": 7
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "salt_bridges",
      "x-ui-group": "输出",
      "x-ui-order": 8
    }
  }
}
