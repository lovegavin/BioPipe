{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "TM-score 参数",
  "properties": {
    "atom_dim": {
      "title": "原子维度名",
      "type": "string",
      "default": "atom",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "field_dim": {
      "title": "字段维度名",
      "type": "string",
      "default": "field",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "reference_path": {
      "title": "参考结构路径 (PDB)",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "model_chains": {
      "title": "模型链（逗号分隔）",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 4
    },
    "reference_chains": {
      "title": "参考链（逗号分隔）",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 5
    },
    "cutoff": {
      "title": "对齐距离阈值 (Å)",
      "type": "number",
      "default": 4.5,
      "minimum": 1.0,
      "maximum": 10.0,
      "x-ui-group": "算法",
      "x-ui-order": 6
    },
    "iterations": {
      "title": "迭代次数上限",
      "type": "integer",
      "default": 30,
      "minimum": 1,
      "maximum": 200,
      "x-ui-group": "算法",
      "x-ui-order": 7
    },
    "model_dim": {
      "title": "输出维度名",
      "type": "string",
      "default": "model",
      "x-ui-group": "输出",
      "x-ui-order": 8
    },
    "model_label": {
      "title": "模型标签",
      "type": "string",
      "default": "model",
      "x-ui-group": "输出",
      "x-ui-order": 9
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "tm",
      "x-ui-group": "输出",
      "x-ui-order": 10
    }
  }
}
