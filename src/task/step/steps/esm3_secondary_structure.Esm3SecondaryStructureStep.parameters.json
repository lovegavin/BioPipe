{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "title": "ESM-3 二级结构预测参数",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "title": "序列维度",
      "type": "string",
      "default": "sequence",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "position_dim": {
      "title": "位点维度",
      "type": "string",
      "default": "position",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "model_name": {
      "title": "模型名称",
      "type": "string",
      "default": "esm3_sm_open_v1",
      "x-ui-group": "模型",
      "x-ui-order": 1
    },
    "device": {
      "title": "设备",
      "type": "string",
      "default": "cpu",
      "enum": [
        "cpu",
        "cuda"
      ],
      "x-ui-group": "模型",
      "x-ui-order": 2
    },
    "num_steps": {
      "title": "生成步数",
      "type": "integer",
      "default": 8,
      "minimum": 1,
      "maximum": 64,
      "x-ui-group": "模型",
      "x-ui-order": 3
    },
    "report_dim": {
      "title": "输出维度",
      "type": "string",
      "default": "residue",
      "x-ui-group": "输出",
      "x-ui-order": 1
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "ss",
      "x-ui-group": "输出",
      "x-ui-order": 2
    }
  }
}
