{
 "$schema": "http://json-schema.org/draft-2020-12/schema",
 "type": "object",
 "title": "密码子适应指数",
 "description": "以参考编码序列计算目标编码序列的 CAI（Sharp & Li 1987）。",
 "additionalProperties": false,
 "properties": {
  "sequence_dim": {
   "type": "string",
   "default": "sequence",
   "title": "序列维度",
   "x-ui-group": "basic",
   "x-ui-order": 10
  },
  "position_dim": {
   "type": "string",
   "default": "position",
   "title": "位置维度",
   "x-ui-group": "basic",
   "x-ui-order": 20
  },
  "reference_sequence_dim": {
   "type": "string",
   "default": "sequence",
   "title": "参考序列维度",
   "x-ui-group": "advanced",
   "x-ui-order": 30
  },
  "reference_position_dim": {
   "type": "string",
   "default": "position",
   "title": "参考位置维度",
   "x-ui-group": "advanced",
   "x-ui-order": 40
  },
  "sequence_output_dim": {
   "type": "string",
   "default": "sequence",
   "title": "输出序列维度",
   "x-ui-group": "advanced",
   "x-ui-order": 50
  },
  "absent_weight": {
   "type": "number",
   "default": 0.5,
   "title": "缺失密码子权重",
   "x-ui-group": "advanced",
   "x-ui-order": 60,
   "minimum": 1e-06,
   "maximum": 1.0
  },
  "exclude_singletons": {
   "type": "boolean",
   "default": true,
   "title": "排除 ATG/TGG",
   "x-ui-group": "advanced",
   "x-ui-order": 70
  },
  "output": {
   "type": "string",
   "default": "cai",
   "title": "输出名称",
   "x-ui-group": "advanced",
   "x-ui-order": 80
  }
 }
}
