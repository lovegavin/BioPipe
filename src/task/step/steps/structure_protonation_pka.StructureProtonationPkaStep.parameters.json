{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "title": "PROPKA 质子化状态",
  "description": "用 pdb2pqr + PROPKA 预测可滴定残基 pKa，并给出目标 pH 下的质子化电荷。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "atom_dim": {
      "title": "原子维度",
      "type": "string",
      "default": "atom",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "field_dim": {
      "title": "字段维度",
      "type": "string",
      "default": "field",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "ph": {
      "title": "目标 pH",
      "type": "number",
      "default": 7.0,
      "minimum": 0.1,
      "maximum": 13.9,
      "x-ui-group": "模型",
      "x-ui-order": 1
    },
    "pdb2pqr_path": {
      "title": "pdb2pqr 可执行文件",
      "type": "string",
      "default": "pdb2pqr30",
      "x-ui-group": "依赖",
      "x-ui-order": 1
    },
    "timeout_seconds": {
      "title": "超时秒数",
      "type": "integer",
      "default": 600,
      "minimum": 30,
      "maximum": 7200,
      "x-ui-group": "依赖",
      "x-ui-order": 2
    },
    "residue_dim": {
      "title": "残基维度",
      "type": "string",
      "default": "residue",
      "x-ui-group": "输出",
      "x-ui-order": 1
    },
    "output": {
      "title": "输出参数",
      "type": "string",
      "default": "pka",
      "x-ui-group": "输出",
      "x-ui-order": 2
    }
  }
}
