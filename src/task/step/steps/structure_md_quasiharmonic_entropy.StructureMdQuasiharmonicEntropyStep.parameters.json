      "x-ui-order": 2
    },
    "n_modes": {
      "title": "输出模式数",
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 200,
      "x-ui-group": "输出",
      "x-ui-order": 3
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "entropy",
      "x-ui-group": "输出",
      "x-ui-order": 4
    }
