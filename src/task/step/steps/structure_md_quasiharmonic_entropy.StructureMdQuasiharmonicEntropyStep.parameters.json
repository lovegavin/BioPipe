{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "准谐振熵参数",
  "properties": {
    "trajectory_path": {
      "title": "轨迹 .npy 路径",
      "type": "string",
