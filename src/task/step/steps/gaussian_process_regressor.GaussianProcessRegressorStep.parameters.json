      "x-ui-order": 10
    },
    "response_label": {
      "type": "string",
      "title": "响应列",
      "x-ui-group": "basic",
      "x-ui-order": 20
    },
    "predictors": {
      "type": "array",
      "items": {
        "type": "string"
