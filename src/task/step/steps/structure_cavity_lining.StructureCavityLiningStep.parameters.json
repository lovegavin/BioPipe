{
 "$schema": "http://json-schema.org/draft-2020-12/schema",
 "type": "object",
 "title": "空腔衬里残基",
 "description": "定位最大埋藏空腔并列出衬里残基及其到空腔的最近距离。",
 "additionalProperties": false,
 "properties": {
  "atom_dim": {
   "type": "string",
   "default": "atom",
   "title": "原子维度",
   "x-ui-group": "advanced",
   "x-ui-order": 10
  },
  "field_dim": {
   "type": "string",
   "default": "field",
   "title": "字段维度",
   "x-ui-group": "advanced",
   "x-ui-order": 20
  },
  "residue_dim": {
   "type": "string",
   "default": "residue",
   "title": "残基维度",
   "x-ui-group": "advanced",
   "x-ui-order": 30
  },
  "spacing": {
   "type": "number",
   "default": 1.0,
   "title": "网格间距",
   "x-ui-group": "advanced",
   "x-ui-order": 40,
   "exclusiveMinimum": 0.5,
   "maximum": 4.0
  },
  "probe_radius": {
   "type": "number",
   "default": 1.4,
   "title": "探测半径",
   "x-ui-group": "advanced",
   "x-ui-order": 50,
   "exclusiveMinimum": 0.5,
   "maximum": 5.0
  },
  "min_volume": {
   "type": "number",
   "default": 20.0,
   "title": "最小空腔体积",
   "x-ui-group": "basic",
   "x-ui-order": 60,
   "minimum": 0.0
  },
  "padding": {
   "type": "number",
   "default": 2.0,
   "title": "边界填充",
   "x-ui-group": "advanced",
   "x-ui-order": 70,
   "minimum": 0.0,
   "maximum": 10.0
  },
  "lining_cutoff": {
   "type": "number",
   "default": 4.0,
   "title": "衬里距离截断",
   "x-ui-group": "basic",
   "x-ui-order": 80,
   "exclusiveMinimum": 0.5,
   "maximum": 12.0
  },
  "output": {
   "type": "string",
   "default": "lining",
   "title": "输出名称",
   "x-ui-group": "advanced",
   "x-ui-order": 90
  }
 }
}
