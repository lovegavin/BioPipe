{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dim": {
      "title": "分析维度",
      "type": "string",
      "default": "feature"
    },
    "other_dim": {
      "title": "样本维度",
      "type": "string",
      "default": "sample"
    },
    "select": {
      "title": "特征选择",
      "enum": [
        "variance",
        "label",
        "all"
      ],
      "default": "variance"
    },
    "labels": {
      "title": "特征标签",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "standardize": {
      "title": "标准化",
      "enum": [
        "none",
        "row",
        "col"
      ],
      "default": "none"
    },
    "filename": {
      "title": "图片文件名",
      "type": "string",
      "x-ui-default": "heatmap.png"
    },
    "title": {
      "title": "图标题",
      "type": "string"
    },
    "cmap": {
      "title": "配色",
      "type": "string",
      "default": "RdBu_r"
    },
    "nan_color": {
      "title": "缺失值颜色",
      "type": "string",
      "default": "#DDDDDD"
    },
    "figsize": {
      "title": "画布尺寸 [宽, 高]",
      "type": [
        "object",
        "array"
      ]
    },
    "top_n": {
      "title": "最多特征数",
      "type": "integer",
      "minimum": 1,
      "default": 50
    },
    "cluster_rows": {
      "title": "聚类行",
      "type": "boolean",
      "default": true
    },
    "cluster_cols": {
      "title": "聚类列",
      "type": "boolean",
      "default": true
    },
    "show_row_labels": {
      "title": "显示行标签",
      "type": "boolean",
      "default": false
    },
    "show_col_labels": {
      "title": "显示列标签",
      "type": "boolean",
      "default": true
    },
    "figure_width_mm": {
      "title": "Figure width (mm)",
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Physical output width; height keeps its aspect ratio unless set separately."
    },
    "figure_height_mm": {
      "title": "Figure height (mm)",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "figure_dpi": {
      "title": "Figure resolution (DPI)",
      "type": "integer",
      "minimum": 72,
      "default": 300,
      "description": "PNG and rasterized layers; PDF/SVG labels and axes remain vector."
    },
    "figure_font_size": {
      "title": "Figure font size (pt)",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 8
    }
  },
  "additionalProperties": true,
  "required": [
    "filename"
  ]
}
