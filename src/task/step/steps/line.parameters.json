{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dim": {
      "title": "维度",
      "type": "string",
      "default": "feature"
    },
    "x_label": {
      "title": "横坐标标签",
      "type": "string",
      "x-ui-default": "f0"
    },
    "y_label": {
      "title": "纵坐标标签",
      "type": "string",
      "x-ui-default": "f1"
    },
    "filename": {
      "title": "文件名",
      "type": "string",
      "x-ui-default": "line.png"
    },
    "sort": {
      "title": "Sort by X",
      "type": "boolean",
      "default": true
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "xlabel": {
      "title": "X axis label",
      "type": "string"
    },
    "ylabel": {
      "title": "Y axis label",
      "type": "string"
    },
    "figure_width_mm": {
      "title": "Figure width (mm)",
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Physical output width; height keeps its aspect ratio unless set separately."
    },
    "figure_height_mm": {
      "title": "Figure height (mm)",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "figure_dpi": {
      "title": "Figure resolution (DPI)",
      "type": "integer",
      "minimum": 72,
      "default": 300,
      "description": "PNG and rasterized layers; PDF/SVG labels and axes remain vector."
    },
    "figure_font_size": {
      "title": "Figure font size (pt)",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 8
    }
  },
  "additionalProperties": true,
  "required": [
    "x_label",
    "y_label",
    "filename"
  ]
}
