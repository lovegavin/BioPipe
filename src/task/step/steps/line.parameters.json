{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dim": {
      "title": "维度",
      "type": "string",
      "default": "feature"
    },
    "x_label": {
      "title": "横坐标标签",
      "type": "string",
      "x-ui-default": "f0"
    },
    "y_label": {
      "title": "纵坐标标签",
      "type": "string",
      "x-ui-default": "f1"
    },
    "filename": {
      "title": "文件名",
      "type": "string",
      "x-ui-default": "line.png"
    },
    "sort": {
      "title": "Sort by X",
      "type": "boolean",
      "default": true
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "xlabel": {
      "title": "X axis label",
      "type": "string"
    },
    "ylabel": {
      "title": "Y axis label",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "x_label",
    "y_label",
    "filename"
  ]
}
