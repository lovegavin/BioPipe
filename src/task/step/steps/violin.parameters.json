{
  "type": "object",
  "properties": {
    "dim": {
      "type": "string",
      "default": "feature"
    },
    "value_label": {
      "type": "string",
      "minLength": 1
    },
    "group_dim": {
      "type": "string",
      "minLength": 1
    },
    "group_label": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "xlabel": {
      "type": "string"
    },
    "ylabel": {
      "type": "string"
    },
    "inner": {
      "type": "string",
      "enum": [
        "box",
        "quartile",
        "point",
        "none"
      ],
      "default": "box"
    },
    "show_points": {
      "type": "boolean",
      "default": false
    },
    "point_size": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 4
    },
    "point_alpha": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5
    },
    "rotate_labels": {
      "type": "boolean",
      "default": false
    },
    "figure_width_mm": {
      "title": "Figure width (mm)",
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Physical output width; height keeps its aspect ratio unless set separately."
    },
    "figure_height_mm": {
      "title": "Figure height (mm)",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "figure_dpi": {
      "title": "Figure resolution (DPI)",
      "type": "integer",
      "minimum": 72,
      "default": 300,
      "description": "PNG and rasterized layers; PDF/SVG labels and axes remain vector."
    },
    "figure_font_size": {
      "title": "Figure font size (pt)",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 8
    }
  },
  "required": [
    "value_label",
    "group_dim",
    "group_label",
    "filename"
  ],
  "additionalProperties": false
}
