{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "氢键寿命参数",
  "properties": {
    "trajectory_path": {
      "title": "轨迹 .npy 路径",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "topology_path": {
      "title": "拓扑 PDB 路径",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "frame_time_ps": {
      "title": "帧间隔（ps）",
      "type": "number",
      "default": 0.2,
      "minimum": 0.001,
      "maximum": 100.0,
      "x-ui-group": "时间",
      "x-ui-order": 3
    },
    "min_occupancy": {
      "title": "最小占据率",
      "type": "number",
      "default": 0.5,
      "minimum": 0.0,
      "maximum": 1.0,
      "x-ui-group": "过滤",
      "x-ui-order": 4
    },
    "max_distance": {
      "title": "H···A 最大距离（Å）",
      "type": "number",
      "default": 3.5,
      "minimum": 2.0,
      "maximum": 5.0,
      "x-ui-group": "判据",
      "x-ui-order": 5
    },
    "min_angle": {
      "title": "最小 D-H···A 角度（°）",
      "type": "number",
      "default": 120.0,
      "minimum": 90.0,
      "maximum": 180.0,
      "x-ui-group": "判据",
      "x-ui-order": 6
    },
    "n_pairs": {
      "title": "输出对数",
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 500,
      "x-ui-group": "输出",
      "x-ui-order": 7
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "lifetimes",
      "x-ui-group": "输出",
      "x-ui-order": 8
    }
  }
}
