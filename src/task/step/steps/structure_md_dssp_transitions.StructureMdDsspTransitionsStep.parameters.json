{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "二级结构状态转换参数",
  "properties": {
    "trajectory_path": {
      "title": "轨迹 .npy 路径",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "topology_path": {
      "title": "拓扑 PDB 路径",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "dssp_path": {
      "title": "mkdssp 路径",
      "type": "string",
      "default": "mkdssp",
      "x-ui-group": "依赖",
      "x-ui-order": 3
    },
    "lag_frames": {
      "title": "滞后帧数",
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 100,
      "x-ui-group": "动力学",
      "x-ui-order": 5
    },
    "frame_time_ps": {
      "title": "帧间隔（ps）",
      "type": "number",
      "default": 0.2,
      "minimum": 0.001,
      "maximum": 100.0,
      "x-ui-group": "动力学",
      "x-ui-order": 6
    },
    "n_residues": {
      "title": "输出残基数（0=全部）",
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 5000,
      "x-ui-group": "输出",
      "x-ui-order": 7
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "transitions",
      "x-ui-group": "输出",
      "x-ui-order": 8
    },
    "timeout_seconds": {
      "title": "单帧 DSSP 超时（秒）",
      "type": "integer",
      "default": 300,
      "minimum": 10,
      "maximum": 3600,
      "x-ui-group": "依赖",
      "x-ui-order": 4
    }
  }
}
