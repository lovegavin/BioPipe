{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "atom_dim": {
      "title": "原子维",
      "type": "string",
      "default": "atom",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "field_dim": {
      "title": "字段维",
      "type": "string",
      "default": "field",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "structure_path": {
      "title": "结构文件",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "mkdssp_path": {
      "title": "mkdssp 路径",
      "type": "string",
      "default": "mkdssp",
      "x-ui-group": "依赖",
      "x-ui-order": 1
    },
    "timeout_seconds": {
      "title": "超时 (s)",
      "type": "integer",
      "default": 300,
      "x-ui-group": "依赖",
      "x-ui-order": 2,
      "minimum": 10,
      "maximum": 3600
    },
    "output": {
      "title": "输出",
      "type": "string",
      "default": "segments",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
