{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dim": {
      "title": "分析维度",
      "type": "string",
      "default": "gene"
    },
    "stat_dim": {
      "title": "统计量维度",
      "type": "string",
      "default": "statistic"
    },
    "lfc_label": {
      "title": "log2FC 字段",
      "type": "string",
      "default": "log2FC"
    },
    "mean_a_label": {
      "title": "对照组均值字段",
      "type": "string",
      "default": "mean_a"
    },
    "mean_b_label": {
      "title": "实验组均值字段",
      "type": "string",
      "default": "mean_b"
    },
    "p_label": {
      "title": "P / Q 字段",
      "type": "string",
      "default": "P"
    },
    "filename": {
      "title": "图片文件名",
      "type": "string",
      "x-ui-default": "ma_plot.png"
    },
    "title": {
      "title": "图标题",
      "type": "string"
    },
    "xlabel": {
      "title": "X 轴标题",
      "type": "string",
      "default": "log2 mean"
    },
    "ylabel": {
      "title": "Y 轴标题",
      "type": "string"
    },
    "p_threshold": {
      "title": "显著性阈值",
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.05
    },
    "point_size": {
      "title": "点大小",
      "type": "number",
      "minimum": 1,
      "default": 8
    },
    "alpha": {
      "title": "透明度",
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.7
    },
    "label_top": {
      "title": "标记前 N 个特征",
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "additionalProperties": true,
  "required": [
    "filename"
  ]
}
