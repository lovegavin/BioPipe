{
  "type": "object",
  "properties": {
    "dim": {
      "type": "string",
      "title": "Dimension to expand"
    },
    "field": {
      "type": "string",
      "title": "Multi-valued field",
      "description": "Info field declared parallel to 'dim'. Each cell is split by 'sep'."
    },
    "sep": {
      "type": "string",
      "title": "Separator",
      "default": ";",
      "minLength": 1
    },
    "keep_empty": {
      "type": "boolean",
      "title": "Keep empty",
      "default": false
    },
    "output": {
      "type": "string",
      "title": "Output key"
    }
  },
  "required": [
    "dim",
    "field"
  ]
}
