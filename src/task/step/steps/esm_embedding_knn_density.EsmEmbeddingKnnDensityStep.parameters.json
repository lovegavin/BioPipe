{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sample_dim": {
      "title": "样本维",
      "type": "string",
      "default": "sequence",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "feature_dim": {
      "title": "特征维",
      "type": "string",
      "default": "embedding",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "k": {
      "title": "邻居数",
      "type": "integer",
      "default": 5,
      "x-ui-group": "模型",
      "x-ui-order": 1,
      "minimum": 1,
      "maximum": 100
    },
    "output": {
      "title": "输出",
      "type": "string",
      "default": "density",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
