{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mood two-sample scale test",
  "description": "Mood test comparing the dispersion of two groups.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "feature_dim": {
      "type": "string",
      "default": "feature",
      "title": "Feature dimension",
      "description": "Name of the feature dimension.",
      "x-ui-group": "Input",
      "x-ui-order": 0
    },
    "sample_dim": {
      "type": "string",
      "default": "sample",
      "title": "Sample dimension",
      "description": "Name of the sample dimension.",
      "x-ui-group": "Input",
      "x-ui-order": 1
    },
    "group_dim": {
      "type": "string",
      "default": "sample",
      "title": "Group dimension",
      "description": "Metadata dimension that holds the sample axis parallel to the group column.",
      "x-ui-group": "Input",
      "x-ui-order": 2
    },
    "group_label": {
      "type": "string",
      "title": "Group column",
      "description": "Metadata column with exactly two group values.",
      "x-ui-group": "Input",
      "x-ui-order": 3
    },
    "alternative": {
      "type": "string",
      "enum": ["two-sided", "less", "greater"],
      "default": "two-sided",
      "title": "Alternative",
      "description": "Direction of the scale difference.",
      "x-ui-group": "Method",
      "x-ui-order": 10
    },
    "output": {
      "type": "string",
      "default": "mood_median",
      "title": "Output name",
      "description": "Name of the output form.",
      "x-ui-group": "Output",
      "x-ui-order": 99
    }
  },
  "required": ["group_label"]
}
