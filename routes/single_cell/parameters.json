{
  "format": "biopipe.task-parameters",
  "schema_version": 1,
  "params": {},
  "sources": {
    "counts": {}
  },
  "steps": [
    {
      "name": "qc_metrics",
      "inputs": [
        "counts"
      ],
      "params": {
        "feature_dim": "gene",
        "sample_dim": "cell",
        "metrics": [
          {
            "name": "total",
            "op": "sum"
          },
          {
            "name": "n_detected",
            "op": "nonzero"
          }
        ],
        "output": "qc"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "qc"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "filter_by",
      "inputs": [
        "counts",
        "qc"
      ],
      "params": {
        "dim": "cell",
        "rules": [
          {
            "field": "total",
            "min": 500
          },
          {
            "field": "n_detected",
            "min": 200
          }
        ],
        "output": "cells_filtered"
      },
      "context_params": {}
    },
    {
      "name": "filter_min",
      "inputs": [
        "cells_filtered"
      ],
      "params": {
        "dim": "gene",
        "min_value": 1,
        "min_samples": 3,
        "output": "genes_filtered"
      },
      "context_params": {}
    },
    {
      "name": "normalize",
      "inputs": [
        "genes_filtered"
      ],
      "params": {
        "method": "total",
        "dim": "cell",
        "target_sum": 1000000.0,
        "output": "cpm"
      },
      "context_params": {}
    },
    {
      "name": "log_transform",
      "inputs": [
        "cpm"
      ],
      "params": {
        "base": "e",
        "pseudocount": 1,
        "output": "logged"
      },
      "context_params": {}
    },
    {
      "name": "rank_axis",
      "inputs": [
        "logged"
      ],
      "params": {
        "dim": "gene",
        "by": "variance",
        "top_n": 2000,
        "keep_ties": false,
        "descending": true,
        "output": "hvg"
      },
      "context_params": {}
    },
    {
      "name": "reduce",
      "inputs": [
        "hvg"
      ],
      "params": {
        "dim": "gene",
        "method": "pca",
        "n_components": 50,
        "standardize": true,
        "random_state": 0,
        "output": "pcs"
      },
      "context_params": {}
    },
    {
      "name": "reduce",
      "inputs": [
        "pcs"
      ],
      "params": {
        "dim": "component",
        "method": "umap",
        "n_components": 2,
        "n_neighbors": 10,
        "min_dist": 0.3,
        "random_state": 0,
        "standardize": true,
        "output": "umap"
      },
      "context_params": {}
    },
    {
      "name": "cluster_axis",
      "inputs": [
        "pcs"
      ],
      "params": {
        "dim": "cell",
        "method": "louvain",
        "n_neighbors": 10,
        "resolution": 2.0,
        "random_state": 0,
        "output": "clusters"
      },
      "context_params": {}
    },
    {
      "name": "compare_groups",
      "inputs": [
        "logged",
        "clusters"
      ],
      "params": {
        "dim": "gene",
        "group_dim": "cell",
        "group_label": "cluster",
        "mode": "one_vs_rest",
        "method": "wilcoxon",
        "min_per_group": 3,
        "output": "markers"
      },
      "context_params": {}
    },
    {
      "name": "scatter",
      "inputs": [
        "umap"
      ],
      "params": {
        "dim": "component",
        "x_label": "UMAP1",
        "y_label": "UMAP2",
        "filename": "umap.png",
        "title": "PBMC 3k: UMAP of cells",
        "xlabel": "UMAP1",
        "ylabel": "UMAP2",
        "alpha": 0.7,
        "point_size": 8,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "clusters"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "markers"
      ],
      "params": {},
      "context_params": {}
    }
  ]
}
