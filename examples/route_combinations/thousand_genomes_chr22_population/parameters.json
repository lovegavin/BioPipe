{
  "format": "operon.task-parameters",
  "schema_version": 1,
  "params": {},
  "sources": {
    "genotypes": {},
    "samples": {
      "header": true
    }
  },
  "steps": [
    {
      "name": "maf",
      "inputs": [
        "genotypes"
      ],
      "params": {
        "dim": "variant",
        "threshold": 0.05,
        "output": "qc_maf"
      },
      "context_params": {}
    },
    {
      "name": "missing",
      "inputs": [
        "qc_maf"
      ],
      "params": {
        "dim": "variant",
        "threshold": 0.1,
        "output": "qc_missing"
      },
      "context_params": {}
    },
    {
      "name": "hwe",
      "inputs": [
        "qc_missing"
      ],
      "params": {
        "dim": "variant",
        "threshold": 1e-06,
        "output": "qc_hwe"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "qc_hwe"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "pca",
      "inputs": [
        "qc_hwe"
      ],
      "params": {
        "dim": "variant",
        "n_components": 4,
        "output": "pcs"
      },
      "context_params": {}
    },
    {
      "name": "boxplot",
      "inputs": [
        "pcs",
        "samples"
      ],
      "params": {
        "dim": "component",
        "value_label": "PC1",
        "group_dim": "sample",
        "group_label": "super_pop",
        "groups": [
          "AFR",
          "AMR",
          "EAS",
          "EUR",
          "SAS"
        ],
        "filename": "pca_pc1_by_superpopulation.png",
        "title": "1000 Genomes chr22: PC1 by super-population",
        "xlabel": "super-population",
        "ylabel": "PC1 score",
        "show_points": true,
        "point_size": 4,
        "point_alpha": 0.5,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "boxplot",
      "inputs": [
        "pcs",
        "samples"
      ],
      "params": {
        "dim": "component",
        "value_label": "PC2",
        "group_dim": "sample",
        "group_label": "super_pop",
        "groups": [
          "AFR",
          "AMR",
          "EAS",
          "EUR",
          "SAS"
        ],
        "filename": "pca_pc2_by_superpopulation.png",
        "title": "1000 Genomes chr22: PC2 by super-population",
        "xlabel": "super-population",
        "ylabel": "PC2 score",
        "show_points": true,
        "point_size": 4,
        "point_alpha": 0.5,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "fst",
      "inputs": [
        "qc_hwe",
        "samples"
      ],
      "params": {
        "variant_dim": "variant",
        "sample_dim": "sample",
        "group_label": "super_pop",
        "group_a": "AFR",
        "group_b": "EUR",
        "output": "fst_afr_eur"
      },
      "context_params": {}
    },
    {
      "name": "histogram",
      "inputs": [
        "fst_afr_eur"
      ],
      "params": {
        "dim": "statistic",
        "value_label": "fst",
        "bins": 30,
        "filename": "fst_afr_eur_histogram.png",
        "title": "1000 Genomes chr22: Hudson Fst (AFR vs EUR)",
        "xlabel": "Hudson Fst",
        "ylabel": "variants",
        "log_y": false,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "relatedness",
      "inputs": [
        "qc_hwe"
      ],
      "params": {
        "variant_dim": "variant",
        "sample_dim": "sample",
        "min_maf": 0.05,
        "output": "grm"
      },
      "context_params": {}
    },
    {
      "name": "rename_dim",
      "inputs": [
        "grm"
      ],
      "params": {
        "from": "sample",
        "to": "individual_1",
        "output": "grm_rows"
      },
      "context_params": {}
    },
    {
      "name": "rename_dim",
      "inputs": [
        "grm_rows"
      ],
      "params": {
        "from": "sample_b",
        "to": "individual_2",
        "output": "grm_labeled"
      },
      "context_params": {}
    },
    {
      "name": "heatmap",
      "inputs": [
        "grm_labeled"
      ],
      "params": {
        "dim": "individual_2",
        "other_dim": "individual_1",
        "select": "all",
        "cluster_rows": true,
        "cluster_cols": true,
        "show_row_labels": false,
        "show_col_labels": false,
        "figsize": [
          8,
          7
        ],
        "filename": "relatedness_heatmap.png",
        "title": "1000 Genomes chr22: genomic relationship",
        "standardize": "none",
        "cmap": "RdBu_r",
        "nan_color": "#DDDDDD",
        "top_n": 50,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    }
  ]
}
