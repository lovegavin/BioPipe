{
  "format": "operon.task-parameters",
  "schema_version": 1,
  "params": {},
  "sources": {
    "cds": {}
  },
  "steps": [
    {
      "name": "sequence_stats",
      "inputs": [
        "cds"
      ],
      "params": {
        "sequence_dim": "sequence",
        "position_dim": "position",
        "fastq_summary": false,
        "record_buffer_mb": 1,
        "output": "cds_stats"
      },
      "context_params": {}
    },
    {
      "name": "drop",
      "inputs": [
        "cds_stats"
      ],
      "params": {
        "dim": "statistic",
        "labels": [
          "n_ratio",
          "valid_ratio"
        ],
        "output": "cds_stats_core"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "cds_stats_core"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "translate",
      "inputs": [
        "cds"
      ],
      "params": {
        "sequence_dim": "sequence",
        "position_dim": "position",
        "frame": 0,
        "to_stop": true,
        "output": "proteins"
      },
      "context_params": {}
    },
    {
      "name": "protein_properties",
      "inputs": [
        "proteins"
      ],
      "params": {
        "sequence_dim": "sequence",
        "position_dim": "position",
        "output": "protein_props"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "protein_props"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "heatmap",
      "inputs": [
        "protein_props"
      ],
      "params": {
        "dim": "sequence",
        "other_dim": "statistic",
        "select": "all",
        "standardize": "col",
        "cluster_rows": true,
        "cluster_cols": true,
        "show_row_labels": true,
        "show_col_labels": true,
        "filename": "protein_properties_by_gene.png",
        "title": "RefSeq CDS: protein physicochemical properties",
        "cmap": "RdBu_r",
        "nan_color": "#DDDDDD",
        "top_n": 50,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "correlation",
      "inputs": [
        "protein_props"
      ],
      "params": {
        "dim": "statistic",
        "metric": "pearson",
        "min_valid": 3,
        "max_positions": null,
        "output": "protein_corr"
      },
      "context_params": {}
    },
    {
      "name": "heatmap",
      "inputs": [
        "protein_corr"
      ],
      "params": {
        "dim": "statistic",
        "other_dim": "statistic_b",
        "select": "all",
        "standardize": "none",
        "cluster_rows": true,
        "cluster_cols": true,
        "show_row_labels": true,
        "show_col_labels": true,
        "filename": "protein_property_correlation.png",
        "title": "RefSeq CDS: protein property correlation",
        "cmap": "RdBu_r",
        "nan_color": "#DDDDDD",
        "top_n": 50,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "codon_usage",
      "inputs": [
        "cds"
      ],
      "params": {
        "sequence_dim": "sequence",
        "position_dim": "position",
        "frame": 0,
        "output": "codon_usage"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "codon_usage"
      ],
      "params": {},
      "context_params": {}
    }
  ]
}
