{
  "version": 1,
  "environments": {
    "antifold": {
      "title": "AntiFold antibody inverse folding",
      "python": "3.11",
      "imports": [
        "antifold",
        "antifold.main"
      ],
      "requirements": [
        "torch==2.3.1",
        "numpy==1.26.4",
        "pandas==2.2.3",
        "tqdm",
        "scipy==1.13.1"
      ],
      "no_deps": [
        "antifold==0.3.1"
      ],
      "weights": [
        {
          "path": "antifold/trained_models/model.pt",
          "url": "https://opig.stats.ox.ac.uk/data/downloads/AntiFold/models/model.pt"
        }
      ],
      "notes": "AntiFold pins NumPy 1.26 and Torch 2.3.1, incompatible with the shared NumPy 2 / Torch 2.6 runtime; pygam has no wheel and is not required for inference.",
      "conda_packages": [
        "numpy=1.26",
        "scikit-learn=1.6"
      ],
      "pip_wheels": [
        "biotite==0.38",
        "torch-geometric==2.4.0",
        "biopython==1.83"
      ]
    },
    "esm3": {
      "title": "ESM-3 sequence and structure generation",
      "python": "3.12",
      "imports": [
        "esm",
        "esm.sdk.api"
      ],
      "requirements": [
        "torch==2.6.0",
        "transformers<4.48.2",
        "tokenizers",
        "huggingface_hub",
        "httpx",
        "requests",
        "cloudpathlib",
        "einops",
        "safetensors",
        "dataclasses-json",
        "zstd",
        "accelerate",
        "attrs",
        "biotite",
        "pandas==2.2.3",
        "numpy==2.1.3",
        "scipy==1.14.1",
        "tqdm",
        "brotli",
        "msgpack-numpy",
        "meson-python",
        "ninja",
        "cython"
      ],
      "no_deps": [],
      "notes": "Verified on licai-srv-node80 (glibc 2.17): Python 3.12, torch 2.6.0, ESM 3.2.2. torch >= 2.9 wheels need manylinux_2_28 and cannot be installed on this OS, so the bridge pins the newest compatible torch. ESM 3.4 requires torch >= 2.11 and is not installable there; the operator surface is unchanged.",
      "wired": true,
      "pip_wheels": [
        "setuptools",
        "wheel",
        "flit-core",
        "hatchling",
        "tenacity",
        "torchvision"
      ],
      "no_build_isolation": [
        "esm @ git+https://github.com/evolutionaryscale/esm.git@v3.2.2"
      ]
    },
    "boltz": {
      "title": "Boltz structure and affinity prediction",
      "python": "3.11",
      "imports": [
        "boltz"
      ],
      "conda_packages": [
        "rdkit",
        "pillow",
        "tqdm",
        "numba",
        "scipy",
        "scikit-learn",
        "gemmi",
        "dm-tree"
      ],
      "torch_cpu": true,
      "pip_wheels": [
        "wandb==0.18.7",
        "lightning-utilities",
        "torchmetrics",
        "pytorch-lightning",
        "hydra-core",
        "omegaconf",
        "mashumaro",
        "einx",
        "chembl_structure_pipeline",
        "einops",
        "biopython",
        "frozendict"
      ],
      "pip_pypi": [
        "ihm",
        "modelcif==1.6",
        "fairscale==0.4.13"
      ],
      "requirements": [],
      "no_deps": [
        "boltz==2.2.1"
      ],
      "wired": true,
      "notes": "Standalone micromamba env: conda supplies rdkit/gemmi/dm-tree (no wheels on this host) and the CPU torch wheel comes from download.pytorch.org; Boltz itself is installed with --no-deps because its strict scipy/wandb pins would otherwise downgrade the shared stack. Verified on glibc 2.17: `import boltz.main` succeeds."
    }
  }
}
