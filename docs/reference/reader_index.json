        "variant",
        "sample"
      ],
      "labels": {
        "variant": "builtin",
        "sample": "builtin"
      },
      "compression": [
        ".gz"
      ]
    },
    "parameters_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "output_contract": {
      "version": 1,
      "numeric": true,
      "info": {
        "missing_code": {
          "type": [
            "number",
            "null"
          ]
        },
        "encoders": {
          "type": "object",
          "optional": true
        },
        "representation": {
          "type": "string",
          "const": "hard_call"
        },
        "ploidy": {
          "type": "integer",
          "min": 1
        },
        "chrom": {
          "type": "array",
          "items": "string"
        },
        "pos": {
          "type": "array",
          "items": "integer"
        }
      },
      "dims": [],
      "labels": [],
      "parallel": [],
      "ndim": 2,
      "values": "allele_count",
      "axis_fields": [
        {
          "axis": 0,
          "fields": [
            "chrom",
            "pos"
          ]
        }
      ],
      "info_open": false
    },
