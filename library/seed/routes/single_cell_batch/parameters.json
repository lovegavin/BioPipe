{
  "format": "operon.task-parameters",
  "schema_version": 1,
  "params": {},
  "sources": {
    "expr": {},
    "meta": {
      "header": true
    },
    "markers": {}
  },
  "steps": [
    {
      "name": "normalize",
      "inputs": [
        "expr"
      ],
      "params": {
        "method": "cpm",
        "dim": "cell",
        "target_sum": 1000000.0,
        "output": "cpm"
      },
      "context_params": {}
    },
    {
      "name": "log_transform",
      "inputs": [
        "cpm"
      ],
      "params": {
        "base": 2,
        "pseudocount": 1,
        "output": "logged"
      },
      "context_params": {}
    },
    {
      "name": "combat",
      "inputs": [
        "logged",
        "meta"
      ],
      "params": {
        "feature_dim": "gene",
        "sample_dim": "cell",
        "batch_label": "batch",
        "method": "combat",
        "output": "corrected"
      },
      "context_params": {}
    },
    {
      "name": "transpose",
      "inputs": [
        "corrected"
      ],
      "params": {
        "order": [
          "cell",
          "gene"
        ],
        "output": "corrected_cells"
      },
      "context_params": {}
    },
    {
      "name": "marker_score",
      "inputs": [
        "corrected_cells",
        "markers"
      ],
      "params": {
        "cell_dim": "cell",
        "gene_dim": "gene",
        "gene_set_dim": "gene_set",
        "min_genes": 2,
        "ctrl_size": 50,
        "n_bins": 25,
        "random_state": 0,
        "output": "scores"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "scores"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "heatmap",
      "inputs": [
        "scores"
      ],
      "params": {
        "dim": "cell",
        "other_dim": "gene_set",
        "select": "all",
        "cluster_cols": false,
        "filename": "marker_scores.png",
        "standardize": "none",
        "cmap": "RdBu_r",
        "nan_color": "#DDDDDD",
        "top_n": 50,
        "cluster_rows": true,
        "show_row_labels": false,
        "show_col_labels": true,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    }
  ]
}
