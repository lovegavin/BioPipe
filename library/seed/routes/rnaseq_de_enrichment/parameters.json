{
  "format": "operon.task-parameters",
  "schema_version": 1,
  "params": {},
  "sources": {
    "counts": {
      "header": true
    },
    "meta": {
      "header": true
    },
    "sets": {}
  },
  "steps": [
    {
      "name": "filter_min",
      "inputs": [
        "counts"
      ],
      "params": {
        "dim": "gene",
        "min_value": 10,
        "min_samples": 3,
        "output": "filtered"
      },
      "context_params": {}
    },
    {
      "name": "compare_groups",
      "inputs": [
        "filtered",
        "meta"
      ],
      "params": {
        "dim": "gene",
        "group_dim": "sample",
        "group_label": "group",
        "group_a": "untrt",
        "group_b": "trt",
        "method": "ttest",
        "mode": "two_groups",
        "min_per_group": 2,
        "output": "de"
      },
      "context_params": {}
    },
    {
      "name": "volcano",
      "inputs": [
        "de"
      ],
      "params": {
        "dim": "gene",
        "stat_dim": "statistic",
        "lfc_label": "log2FC",
        "p_label": "P",
        "filename": "de_volcano.png",
        "ylabel": "-log10(P)",
        "lfc_threshold": 1.0,
        "p_threshold": 0.05,
        "point_size": 8,
        "alpha": 0.7,
        "label_top": 0,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "ma_plot",
      "inputs": [
        "de"
      ],
      "params": {
        "dim": "gene",
        "stat_dim": "statistic",
        "lfc_label": "log2FC",
        "mean_a_label": "mean_a",
        "mean_b_label": "mean_b",
        "p_label": "P",
        "filename": "de_ma.png",
        "xlabel": "log2 mean",
        "p_threshold": 0.05,
        "point_size": 8,
        "alpha": 0.7,
        "label_top": 0,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "gsea",
      "inputs": [
        "de",
        "sets"
      ],
      "params": {
        "gene_dim": "gene",
        "stat_dim": "statistic",
        "gene_set_dim": "gene_set",
        "rank_label": "log2FC",
        "n_permutations": 200,
        "min_set_size": 3,
        "max_set_size": 20,
        "seed": 7,
        "weight": 1.0,
        "correction": "fdr",
        "output": "gsea"
      },
      "context_params": {}
    },
    {
      "name": "enrichment_plot",
      "inputs": [
        "gsea"
      ],
      "params": {
        "term_dim": "gene_set",
        "q_column": "Q_VALUE",
        "size_column": "set_size",
        "filename": "gsea.png",
        "statistic_dim": "statistic",
        "top_n": 20,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "de"
      ],
      "params": {},
      "context_params": {}
    }
  ]
}
