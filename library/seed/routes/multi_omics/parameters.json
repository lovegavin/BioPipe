{
  "format": "biopipe.task-parameters",
  "schema_version": 1,
  "params": {},
  "sources": {
    "rna": {
      "feature_type": "Gene Expression",
      "feature_id_field": "name"
    },
    "protein": {
      "feature_type": "Antibody Capture",
      "feature_id_field": "name"
    }
  },
  "steps": [
    {
      "name": "normalize",
      "inputs": [
        "rna"
      ],
      "params": {
        "method": "cpm",
        "dim": "cell",
        "target_sum": 1000000.0,
        "output": "rna_cpm"
      },
      "context_params": {}
    },
    {
      "name": "log_transform",
      "inputs": [
        "rna_cpm"
      ],
      "params": {
        "base": 2,
        "pseudocount": 1,
        "output": "rna_log"
      },
      "context_params": {}
    },
    {
      "name": "rank_axis",
      "inputs": [
        "rna_log"
      ],
      "params": {
        "dim": "gene",
        "by": "variance",
        "top_n": 2000,
        "keep_ties": false,
        "descending": true,
        "output": "rna_hvg"
      },
      "context_params": {}
    },
    {
      "name": "reduce",
      "inputs": [
        "rna_hvg"
      ],
      "params": {
        "dim": "gene",
        "method": "pca",
        "n_components": 20,
        "standardize": true,
        "random_state": 0,
        "output": "rna_pcs"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "rna_pcs"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "normalize",
      "inputs": [
        "protein"
      ],
      "params": {
        "method": "total",
        "dim": "cell",
        "target_sum": 1000000.0,
        "output": "protein_norm"
      },
      "context_params": {}
    },
    {
      "name": "log_transform",
      "inputs": [
        "protein_norm"
      ],
      "params": {
        "base": 2,
        "pseudocount": 1,
        "output": "protein_log"
      },
      "context_params": {}
    },
    {
      "name": "reduce",
      "inputs": [
        "protein_log"
      ],
      "params": {
        "dim": "protein",
        "method": "pca",
        "n_components": 20,
        "standardize": true,
        "random_state": 0,
        "output": "protein_pcs"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "protein_pcs"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "join",
      "inputs": [
        "rna_pcs",
        "protein_pcs"
      ],
      "params": {
        "dim": "cell",
        "columns": "all",
        "how": "inner",
        "prefix": "prot_",
        "output": "joint_pcs"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "joint_pcs"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "rank_axis",
      "inputs": [
        "protein_log"
      ],
      "params": {
        "dim": "cell",
        "by": "variance",
        "top_n": 500,
        "descending": true,
        "keep_ties": false,
        "output": "protein_var"
      },
      "context_params": {}
    },
    {
      "name": "correlation",
      "inputs": [
        "protein_var"
      ],
      "params": {
        "dim": "cell",
        "metric": "pearson",
        "min_valid": 3,
        "max_positions": null,
        "output": "protein_corr"
      },
      "context_params": {}
    },
    {
      "name": "heatmap",
      "inputs": [
        "protein_corr"
      ],
      "params": {
        "dim": "cell",
        "other_dim": "cell_b",
        "select": "all",
        "standardize": "none",
        "cluster_rows": false,
        "cluster_cols": false,
        "filename": "protein_cell_correlation.png",
        "title": "Cell-cell correlation across 32 surface proteins",
        "cmap": "RdBu_r",
        "nan_color": "#DDDDDD",
        "top_n": 50,
        "show_row_labels": false,
        "show_col_labels": true,
        "figure_dpi": 300,
        "figure_font_size": 8
      },
      "context_params": {}
    }
  ]
}
