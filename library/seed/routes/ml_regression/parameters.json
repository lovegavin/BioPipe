{
  "format": "operon.task-parameters",
  "schema_version": 1,
  "params": {},
  "sources": {
    "proteins": {
      "reader": "csv",
      "sep": "\t",
      "header": true
    },
    "clinical": {
      "reader": "csv",
      "sep": "\t",
      "header": true
    }
  },
  "steps": [
    {
      "name": "missing",
      "inputs": [
        "proteins"
      ],
      "params": {
        "dim": "protein",
        "threshold": 0.5,
        "output": "prot_filtered"
      },
      "context_params": {}
    },
    {
      "name": "impute",
      "inputs": [
        "prot_filtered"
      ],
      "params": {
        "method": "min",
        "dim": "protein",
        "min_scale": 1.0,
        "output": "prot_imputed"
      },
      "context_params": {}
    },
    {
      "name": "normalize",
      "inputs": [
        "prot_imputed"
      ],
      "params": {
        "method": "quantile",
        "dim": "sample",
        "target_sum": 1000000.0,
        "output": "prot_qn"
      },
      "context_params": {}
    },
    {
      "name": "log_transform",
      "inputs": [
        "prot_qn"
      ],
      "params": {
        "base": 2,
        "pseudocount": 1,
        "output": "prot_log"
      },
      "context_params": {}
    },
    {
      "name": "transpose",
      "inputs": [
        "prot_log"
      ],
      "params": {
        "order": [
          "sample",
          "protein"
        ],
        "output": "samples_by_protein"
      },
      "context_params": {}
    },
    {
      "name": "ridge_regression",
      "inputs": [
        "samples_by_protein",
        "clinical"
      ],
      "params": {
        "sample_dim": "sample",
        "feature_dim": "protein",
        "label_dim": "feature",
        "target_label": "Age",
        "alpha": 10.0,
        "test_size": 0.25,
        "cv_folds": 3,
        "random_state": 42,
        "scale": true,
        "output": "ridge"
      },
      "context_params": {}
    },
    {
      "name": "random_forest_regressor",
      "inputs": [
        "samples_by_protein",
        "clinical"
      ],
      "params": {
        "sample_dim": "sample",
        "feature_dim": "protein",
        "label_dim": "feature",
        "target_label": "Age",
        "n_estimators": 200,
        "test_size": 0.25,
        "cv_folds": 3,
        "random_state": 42,
        "scale": true,
        "max_depth": null,
        "output": "rf"
      },
      "context_params": {}
    },
    {
      "name": "gradient_boosting_regressor",
      "inputs": [
        "samples_by_protein",
        "clinical"
      ],
      "params": {
        "sample_dim": "sample",
        "feature_dim": "protein",
        "label_dim": "feature",
        "target_label": "Age",
        "n_estimators": 100,
        "learning_rate": 0.1,
        "max_depth": 3,
        "test_size": 0.25,
        "cv_folds": 3,
        "random_state": 42,
        "scale": true,
        "output": "gb"
      },
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "ridge"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "rf"
      ],
      "params": {},
      "context_params": {}
    },
    {
      "name": "describe",
      "inputs": [
        "gb"
      ],
      "params": {},
      "context_params": {}
    }
  ]
}
