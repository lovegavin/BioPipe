{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sequence_dim": {
      "type": "string",
      "title": "Sequence dimension",
      "default": "sequence"
    },
    "position_dim": {
      "type": "string",
      "title": "Position dimension",
      "default": "position"
    },
    "node_dim": {
      "type": "string",
      "title": "Node dimension",
      "default": "node"
    },
    "field_dim": {
      "type": "string",
      "title": "Field dimension",
      "default": "field"
    },
    "split_dim": {
      "type": "string",
      "title": "Split dimension",
      "default": "split"
    },
    "statistic_dim": {
      "type": "string",
      "title": "Statistic dimension",
      "default": "statistic"
    },
    "resamples": {
      "type": "integer",
      "title": "Bootstrap replicates",
      "default": 100,
      "minimum": 1,
      "maximum": 1000
    },
    "seed": {
      "type": "integer",
      "title": "Random seed",
      "default": 0,
      "minimum": 0,
      "maximum": 2147483647
    },
    "output": {
      "type": "string",
      "title": "Output table",
      "default": "bootstrap"
    }
  },
  "required": [
    "resamples",
    "seed"
  ],
  "additionalProperties": false,
  "x-ui-group": "Phylogenetics"
}
