{
  "type": "object",
  "properties": {
    "term_dim": {
      "type": "string",
      "title": "Term dimension"
    },
    "statistic_dim": {
      "type": "string",
      "title": "Statistic dimension",
      "default": "statistic"
    },
    "q_column": {
      "type": "string",
      "title": "Q-value column",
      "default": "Q_VALUE"
    },
    "size_column": {
      "type": "string",
      "title": "Color column",
      "default": "n_hit"
    },
    "top_n": {
      "type": "integer",
      "title": "Top N terms",
      "minimum": 1,
      "default": 20
    },
    "filename": {
      "type": "string",
      "title": "Output filename",
      "default": "enrichment.png"
    },
    "title": {
      "type": "string",
      "title": "Plot title"
    },
    "figure_width_mm": {
      "title": "Figure width (mm)",
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Physical output width; height keeps its aspect ratio unless set separately."
    },
    "figure_height_mm": {
      "title": "Figure height (mm)",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "figure_dpi": {
      "title": "Figure resolution (DPI)",
      "type": "integer",
      "minimum": 72,
      "default": 300,
      "description": "PNG and rasterized layers; PDF/SVG labels and axes remain vector."
    },
    "figure_font_size": {
      "title": "Figure font size (pt)",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 8
    }
  },
  "additionalProperties": false
}
