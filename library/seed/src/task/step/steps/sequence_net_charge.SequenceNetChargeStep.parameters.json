{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "title": "序列维",
      "type": "string",
      "default": "sequence",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "position_dim": {
      "title": "位置维",
      "type": "string",
      "default": "position",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "window": {
      "title": "窗口长度",
      "type": "integer",
      "default": 9,
      "x-ui-group": "检测",
      "x-ui-order": 1,
      "minimum": 1,
      "maximum": 101
    },
    "output": {
      "title": "输出",
      "type": "string",
      "default": "charge",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
