{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "ProteinMPNN 多模型共识",
  "additionalProperties": false,
  "properties": {
    "structure_path": {
      "type": "string",
      "default": "",
      "title": "结构文件",
      "description": "骨架 PDB 的路径。",
      "x-ui-group": "basic",
      "x-ui-order": 0
    },
    "proteinmpnn_path": {
      "type": "string",
      "default": "",
      "title": "ProteinMPNN 目录",
      "description": "官方 ProteinMPNN 仓库路径，留空时读取 OPERON_PROTEINMPNN_PATH。",
      "x-ui-group": "basic",
      "x-ui-order": 10
    },
    "weights_path": {
      "type": "string",
      "default": "",
      "title": "权重目录",
      "description": "模型权重目录，留空时使用仓库下的 vanilla_model_weights。",
      "x-ui-group": "advanced",
      "x-ui-order": 0
    },
    "python_executable": {
      "type": "string",
      "default": "",
      "title": "Python 解释器",
      "description": "运行官方脚本的解释器，留空时使用当前解释器。",
      "x-ui-group": "advanced",
      "x-ui-order": 10
    },
    "models": {
      "type": "string",
      "default": "v_48_002,v_48_020",
      "title": "模型列表",
      "description": "逗号分隔的 ProteinMPNN checkpoint 列表。",
      "x-ui-group": "basic",
      "x-ui-order": 20
    },
    "num_seq_per_target": {
      "type": "integer",
      "default": 4,
      "minimum": 1,
      "maximum": 200,
      "title": "每模型设计数",
      "description": "每个 checkpoint 生成的设计条数。",
      "x-ui-group": "basic",
      "x-ui-order": 30
    },
    "sampling_temp": {
      "type": "string",
      "default": "0.1",
      "title": "采样温度",
      "description": "ProteinMPNN 采样温度。",
      "x-ui-group": "basic",
      "x-ui-order": 40
    },
    "seed": {
      "type": "integer",
      "default": 1,
      "minimum": 0,
      "title": "随机种子",
      "description": "采样种子，0 表示随机种子。",
      "x-ui-group": "advanced",
      "x-ui-order": 30
    },
    "chains": {
      "type": "string",
      "default": "",
      "title": "设计链",
      "description": "逗号分隔的设计链，留空表示全部链。",
      "x-ui-group": "advanced",
      "x-ui-order": 40
    },
    "device": {
      "type": "string",
      "default": "cpu",
      "enum": ["cpu", "cuda"],
      "title": "设备",
      "description": "运行设备。",
      "x-ui-group": "advanced",
      "x-ui-order": 50
    },
    "timeout": {
      "type": "number",
      "default": 1800,
      "minimum": 1,
      "title": "超时秒数",
      "description": "单个模型子进程的超时时间。",
      "x-ui-group": "advanced",
      "x-ui-order": 60
    },
    "position_dim": {
      "type": "string",
      "default": "position",
      "title": "位点维度",
      "description": "输出位点维度的名称。",
      "x-ui-group": "advanced",
      "x-ui-order": 70
    },
    "amino_acid_dim": {
      "type": "string",
      "default": "amino_acid",
      "title": "氨基酸维度",
      "description": "输出氨基酸维度的名称。",
      "x-ui-group": "advanced",
      "x-ui-order": 80
    },
    "output": {
      "type": "string",
      "default": "consensus",
      "title": "输出名称",
      "description": "输出 Form 的名称。",
      "x-ui-group": "advanced",
      "x-ui-order": 90
    }
  }
}
