{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructureCisPeptidesStep parameters",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "atom_dim": {
      "type": "string",
      "default": "atom",
      "title": "原子维度",
      "description": "PDB Form 的原子维度名。",
      "x-ui-group": "basic",
      "x-ui-order": 0
    },
    "field_dim": {
      "type": "string",
      "default": "field",
      "title": "字段维度",
      "description": "PDB Form 的字段维度名。",
      "x-ui-group": "basic",
      "x-ui-order": 10
    },
    "bond_dim": {
      "type": "string",
      "default": "bond",
      "title": "肽键维度",
      "description": "输出矩阵的肽键维度名。",
      "x-ui-group": "basic",
      "x-ui-order": 20
    },
    "cis_threshold": {
      "type": "number",
      "default": 30.0,
      "minimum": 0.0,
      "maximum": 90.0,
      "title": "顺式阈值（度）",
      "description": "|omega| 不超过该角度时判为顺式肽键。",
      "x-ui-group": "basic",
      "x-ui-order": 30
    },
    "chain": {
      "type": "string",
      "default": "",
      "title": "限定链",
      "description": "仅分析指定链；留空表示全部分子链。",
      "x-ui-group": "advanced",
      "x-ui-order": 40
    },
    "output": {
      "type": "string",
      "default": "cis_peptides",
      "title": "输出参数",
      "description": "写入上下文的结果参数名。",
      "x-ui-group": "advanced",
      "x-ui-order": 50
    }
  }
}
