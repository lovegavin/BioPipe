{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "atom_dim": {
      "title": "原子维",
      "type": "string",
      "default": "atom",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "field_dim": {
      "title": "字段维",
      "type": "string",
      "default": "field",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "query_path": {
      "title": "查询结构",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "database_path": {
      "title": "结构数据库",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 4
    },
    "threads": {
      "title": "线程数",
      "type": "integer",
      "default": 1,
      "x-ui-group": "搜索",
      "x-ui-order": 1,
      "minimum": 1,
      "maximum": 64
    },
    "max_hits": {
      "title": "最大命中数",
      "type": "integer",
      "default": 100,
      "x-ui-group": "搜索",
      "x-ui-order": 2,
      "minimum": 1,
      "maximum": 10000
    },
    "foldseek_path": {
      "title": "foldseek 命令",
      "type": "string",
      "default": "foldseek",
      "x-ui-group": "依赖",
      "x-ui-order": 1
    },
    "timeout_seconds": {
      "title": "超时 (s)",
      "type": "integer",
      "default": 1800,
      "x-ui-group": "依赖",
      "x-ui-order": 2,
      "minimum": 30,
      "maximum": 21600
    },
    "output": {
      "title": "输出",
      "type": "string",
      "default": "hits",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
