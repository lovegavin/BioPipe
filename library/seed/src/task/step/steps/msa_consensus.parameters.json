{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Alignment consensus parameters",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "type": "string",
      "default": "sequence",
      "description": "Name of the sequence axis."
    },
    "position_dim": {
      "type": "string",
      "default": "position",
      "description": "Name of the alignment position axis."
    },
    "alphabet": {
      "type": "string",
      "enum": ["auto", "dna", "rna", "protein"],
      "default": "auto",
      "description": "Residue alphabet used for the ambiguous character."
    },
    "max_gap_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "description": "Columns with a larger gap fraction become ambiguous."
    },
    "min_major_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "description": "Columns whose majority residue is less frequent become ambiguous."
    },
    "output": {
      "type": "string",
      "default": "consensus",
      "description": "Name of the output form."
    }
  }
}
