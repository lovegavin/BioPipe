{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gene_dim": {
      "type": "string",
      "default": "gene"
    },
    "statistic_dim": {
      "type": "string",
      "default": "statistic"
    },
    "growth_threshold": {
      "type": "number",
      "default": 0.01,
      "minimum": 0.0
    },
    "max_genes": {
      "type": "integer",
      "default": 0,
      "minimum": 0
    },
    "output": {
      "type": "string",
      "default": "knockout"
    }
  },
  "additionalProperties": false
}
