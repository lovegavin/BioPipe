   "x-ui-group": "advanced",
   "x-ui-order": 70,
   "minimum": 1
  },
  "output": {
   "type": "string",
   "default": "bridges",
   "title": "输出名称",
   "x-ui-group": "advanced",
   "x-ui-order": 80
  }
 }
}
