{
 "$schema": "http://json-schema.org/draft-2020-12/schema",
 "type": "object",
 "title": "二级结构桥接网络",
 "description": "二级结构元件之间的最近距离与接触数网络。",
 "additionalProperties": false,
 "properties": {
  "atom_dim": {
   "type": "string",
   "default": "atom",
