   "x-ui-order": 10
  },
  "field_dim": {
   "type": "string",
   "default": "field",
   "title": "字段维度",
   "x-ui-group": "basic",
   "x-ui-order": 20
  },
  "bridge_dim": {
   "type": "string",
   "default": "bridge",
   "title": "桥接维度",
   "x-ui-group": "advanced",
   "x-ui-order": 30
  },
  "window": {
   "type": "integer",
   "default": 5,
   "title": "螺旋/折叠识别窗口",
