{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "title": "界面丙氨酸扫描",
  "description": "对界面残基逐个突变为丙氨酸，用单点 MM/GBSA 估计 ΔΔG。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "atom_dim": {
      "title": "原子维度",
      "type": "string",
      "default": "atom",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "field_dim": {
      "title": "字段维度",
      "type": "string",
      "default": "field",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "binder_chains": {
      "title": "结合方链",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "target_chains": {
      "title": "靶方链",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 4
    },
    "cutoff": {
      "title": "界面距离阈值 Å",
      "type": "number",
      "default": 4.5,
      "minimum": 1.0,
      "maximum": 12.0,
      "x-ui-group": "模型",
      "x-ui-order": 1
    },
    "max_residues": {
      "title": "最多扫描残基数",
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 200,
      "x-ui-group": "模型",
      "x-ui-order": 2
    },
    "ph": {
      "title": "质子化 pH",
      "type": "number",
      "default": 7.0,
      "minimum": 0.1,
      "maximum": 13.9,
      "x-ui-group": "模型",
      "x-ui-order": 3
    },
    "forcefield": {
      "title": "力场文件",
      "type": "string",
      "default": "amber14-all.xml",
      "x-ui-group": "模型",
      "x-ui-order": 4
    },
    "implicit_model": {
      "title": "隐式溶剂",
      "type": "string",
      "default": "implicit/gbn2.xml",
      "x-ui-group": "模型",
      "x-ui-order": 5
    },
    "mutation_dim": {
      "title": "突变维度",
      "type": "string",
      "default": "mutation",
      "x-ui-group": "输出",
      "x-ui-order": 1
    },
    "output": {
      "title": "输出参数",
      "type": "string",
      "default": "scan",
      "x-ui-group": "输出",
      "x-ui-order": 2
    }
  }
}
