      "type": "boolean",
      "x-ui-group": "输入",
      "x-ui-order": 5,
      "default": false
    },
    "output": {
      "title": "输出参数",
      "description": "写入位点表的参数名",
      "type": "string",
      "x-ui-group": "输入",
      "x-ui-order": 6,
      "default": "sites"
    }
  },
  "x-ui-order": [
    "atom_dim",
    "field_dim",
    "site_dim",
    "min_sasa",
    "include_o_linked",
    "output"
  ]
