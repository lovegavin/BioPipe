{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ESM-3 逆折叠参数",
  "properties": {
    "structure_path": {
      "title": "主链结构 (PDB)",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "chain": {
      "title": "链",
      "type": "string",
      "default": "A",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "num_steps": {
      "title": "生成步数",
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 200,
      "x-ui-group": "生成",
      "x-ui-order": 3
    },
    "temperature": {
      "title": "温度",
      "type": "number",
      "default": 1.0,
      "minimum": 0.01,
      "maximum": 5.0,
      "x-ui-group": "生成",
      "x-ui-order": 4
    },
    "device": {
      "title": "计算设备",
      "type": "string",
      "default": "cpu",
      "enum": [
        "cpu",
        "cuda"
      ],
      "x-ui-group": "模型",
      "x-ui-order": 5
    },
    "design_dim": {
      "title": "输出维度名",
      "type": "string",
      "default": "design",
      "x-ui-group": "输出",
      "x-ui-order": 6
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "designs",
      "x-ui-group": "输出",
      "x-ui-order": 7
    }
  }
}
