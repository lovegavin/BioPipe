{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "title": "序列维",
      "type": "string",
      "default": "sequence",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "position_dim": {
      "title": "位置维",
      "type": "string",
      "default": "position",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "window": {
      "title": "窗口长度",
      "type": "integer",
      "default": 5,
      "x-ui-group": "检测",
      "x-ui-order": 1,
      "minimum": 2,
      "maximum": 31
    },
    "threshold": {
      "title": "阈值",
      "type": "number",
      "default": 0.35,
      "x-ui-group": "检测",
      "x-ui-order": 2,
      "minimum": -2.0,
      "maximum": 2.0
    },
    "min_length": {
      "title": "最短片段",
      "type": "integer",
      "default": 3,
      "x-ui-group": "检测",
      "x-ui-order": 3,
      "minimum": 1,
      "maximum": 100
    },
    "output": {
      "title": "输出",
      "type": "string",
      "default": "hotspots",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
