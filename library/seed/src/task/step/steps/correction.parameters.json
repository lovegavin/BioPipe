{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "method": {
      "title": "校正方法",
      "enum": [
        "fdr",
        "bonferroni"
      ],
      "default": "bonferroni",
      "x-ui-default": "fdr"
    },
    "alpha": {
      "title": "显著性水平",
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.05,
      "x-ui-step": 0.01
    },
    "pfield": {
      "title": "P 值标签",
      "type": "string",
      "default": "P"
    },
    "dim": {
      "title": "统计量维度",
      "type": "string",
      "default": "statistic"
    }
  },
  "additionalProperties": true,
  "required": []
}
