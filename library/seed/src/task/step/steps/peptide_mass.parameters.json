{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "peptide_dim": {
      "type": "string",
      "title": "Peptide dimension",
      "default": "peptide",
      "x-ui-group": "Dimensions"
    },
    "field_dim": {
      "type": "string",
      "title": "Field dimension",
      "default": "field",
      "x-ui-group": "Dimensions"
    },
    "charge": {
      "type": "integer",
      "title": "Ion charge",
      "minimum": 1,
      "maximum": 5,
      "default": 2,
      "x-ui-group": "Mass"
    },
    "output": {
      "type": "string",
      "title": "Output name",
      "default": "masses",
      "x-ui-group": "Output"
    }
  },
  "additionalProperties": false
}
