{
  "type": "object",
  "properties": {
    "dim": {
      "type": "string",
      "minLength": 1
    },
    "sample_dim": {
      "type": "string",
      "minLength": 1
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "top_n": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "default": 20
    },
    "other_label": {
      "type": "string",
      "default": "Other"
    },
    "normalize": {
      "type": "boolean",
      "default": true
    },
    "title": {
      "type": "string"
    },
    "xlabel": {
      "type": "string"
    },
    "ylabel": {
      "type": "string"
    },
    "cmap": {
      "type": "string",
      "default": "tab20"
    },
    "figsize": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "legend": {
      "type": "boolean",
      "default": true
    },
    "legend_ncol": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "rotate_labels": {
      "type": "boolean",
      "default": true
    },
    "figure_width_mm": {
      "title": "Figure width (mm)",
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Physical output width; height keeps its aspect ratio unless set separately."
    },
    "figure_height_mm": {
      "title": "Figure height (mm)",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "figure_dpi": {
      "title": "Figure resolution (DPI)",
      "type": "integer",
      "minimum": 72,
      "default": 300,
      "description": "PNG and rasterized layers; PDF/SVG labels and axes remain vector."
    },
    "figure_font_size": {
      "title": "Figure font size (pt)",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 8
    }
  },
  "required": [
    "dim",
    "sample_dim",
    "filename"
  ],
  "additionalProperties": false
}
