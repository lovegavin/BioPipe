{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enzyme": {
      "type": "string",
      "title": "Protease",
      "enum": [
        "trypsin",
        "lys-c",
        "arg-c"
      ],
      "default": "trypsin",
      "x-ui-group": "Digestion"
    },
    "missed_cleavages": {
      "type": "integer",
      "title": "Allowed missed cleavages",
      "minimum": 0,
      "maximum": 3,
      "default": 0,
      "x-ui-group": "Digestion"
    },
    "min_length": {
      "type": "integer",
      "title": "Minimum peptide length",
      "minimum": 1,
      "default": 6,
      "x-ui-group": "Filters"
    },
    "max_length": {
      "type": "integer",
      "title": "Maximum peptide length (0 = unlimited)",
      "minimum": 0,
      "default": 50,
      "x-ui-group": "Filters"
    },
    "sequence_dim": {
      "type": "string",
      "title": "Sequence dimension",
      "default": "sequence",
      "x-ui-group": "Dimensions"
    },
    "position_dim": {
      "type": "string",
      "title": "Position dimension",
      "default": "position",
      "x-ui-group": "Dimensions"
    },
    "output": {
      "type": "string",
      "title": "Output name",
      "default": "peptides",
      "x-ui-group": "Output"
    }
  },
  "additionalProperties": false
}
