{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "title": "AMRFinderPlus 耐药基因参数",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "title": "序列维度",
      "type": "string",
      "default": "sequence",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "position_dim": {
      "title": "位置维度",
      "type": "string",
      "default": "position",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "amrfinder_path": {
      "title": "amrfinder 可执行文件",
      "type": "string",
      "default": "amrfinder",
      "x-ui-group": "依赖",
      "x-ui-order": 1
    },
    "database_dir": {
      "title": "AMRFinder 数据库目录",
      "type": "string",
      "default": "",
      "x-ui-group": "依赖",
      "x-ui-order": 2
    },
    "mode": {
      "title": "输入类型",
      "type": "string",
      "enum": ["protein", "nucleotide"],
      "default": "protein",
      "x-ui-group": "参数",
      "x-ui-order": 1
    },
    "organism": {
      "title": "物种分组",
      "type": "string",
      "default": "",
      "x-ui-group": "参数",
      "x-ui-order": 2
    },
    "threads": {
      "title": "线程数",
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 64,
      "x-ui-group": "参数",
      "x-ui-order": 3
    },
    "timeout_seconds": {
      "title": "超时 (秒)",
      "type": "integer",
      "default": 1800,
      "minimum": 30,
      "maximum": 21600,
      "x-ui-group": "参数",
      "x-ui-order": 4
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "hits",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
