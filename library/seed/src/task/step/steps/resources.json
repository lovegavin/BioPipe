{
  "protocol_version": 1,
  "description": "Large resources (model weights, databases, external checkouts) that operators load at run time. Each entry lists the files that must exist before the dependent operator can run.",
  "resources": [
    {
      "id": "proteinmpnn",
      "title": "ProteinMPNN official checkout",
      "kind": "code+weights",
      "url": "https://github.com/dauparas/ProteinMPNN",
      "install": "git clone https://github.com/dauparas/ProteinMPNN.git && download the v_48_* weights into vanilla_model_weights/",
      "env": "OPERON_PROTEINMPNN_PATH",
      "roots": [
        "~/.local/share/operon/resources/proteinmpnn"
      ],
      "files": [
        "protein_mpnn_run.py",
        "vanilla_model_weights/v_48_020.pt"
      ]
    },
    {
      "id": "ligandmpnn",
      "title": "LigandMPNN official checkout",
      "kind": "code+weights",
      "url": "https://github.com/dauparas/LigandMPNN",
      "install": "git clone https://github.com/dauparas/LigandMPNN.git && download model_params/ligandmpnn_v_32_010_25.pt",
      "env": "OPERON_LIGANDMPNN_PATH",
      "roots": [
        "~/.local/share/operon/resources/ligandmpnn"
      ],
      "files": [
        "run.py",
        "model_params/ligandmpnn_v_32_010_25.pt"
      ]
    },
    {
      "id": "esm2",
      "title": "ESM-2 checkpoint",
      "kind": "weights",
      "url": "https://dl.fbaipublicfiles.com/fair-esm/models/esm2_t6_8M_UR50D.pt",
      "install": "curl -L https://dl.fbaipublicfiles.com/fair-esm/models/esm2_t6_8M_UR50D.pt -o esm2_t6_8M_UR50D.pt",
      "env": "OPERON_ESM_MODEL_DIR",
      "roots": [
        "~/.local/share/operon/resources/esm2"
      ],
      "files": [
        "esm2_t6_8M_UR50D.pt"
      ]
    },
    {
      "id": "esm_if1",
      "title": "ESM-IF1 inverse-folding checkpoint",
      "kind": "weights",
      "url": "https://dl.fbaipublicfiles.com/fair-esm/models/esm_if1_gvp4_t16_142M_UR50.pt",
      "install": "curl -L https://dl.fbaipublicfiles.com/fair-esm/models/esm_if1_gvp4_t16_142M_UR50.pt -o esm_if1_gvp4_t16_142M_UR50.pt",
      "env": "OPERON_ESM_MODEL_DIR",
      "roots": [
        "~/.local/share/operon/resources/esm_if1"
      ],
      "files": [
        "esm_if1_gvp4_t16_142M_UR50.pt"
      ]
    },
    {
      "id": "esmfold",
      "title": "ESMFold 3B checkpoint",
      "kind": "weights",
      "url": "https://dl.fbaipublicfiles.com/fair-esm/models/esmfold_3B_v1.pt",
      "install": "python -c \"import esm; esm.pretrained.esmfold_v1()\" (downloads about 2.5 GB on first use)",
      "env": "OPERON_ESMFOLD_WEIGHTS",
      "roots": [
        "~/.cache/torch/hub/checkpoints",
        "~/.local/share/operon/resources/esmfold"
      ],
      "files": [
        "esmfold_3B_v1.pt"
      ]
    },
    {
      "id": "colabfold",
      "title": "ColabFold local installation",
      "kind": "binary+databases",
      "url": "https://github.com/sokrypton/ColabFold",
      "install": "pip install \"colabfold[alphafold]\" && download the MMseqs2/UniRef databases as described in docs/large_resources.md",
      "env": "OPERON_COLABFOLD_PATH",
      "roots": [
        "/usr/local/bin",
        "~/.local/share/operon/resources/colabfold"
      ],
      "files": [
        "colabfold_batch"
      ]
    },
    {
      "id": "alphafold2",
      "title": "AlphaFold2 parameters",
      "kind": "weights+databases",
      "url": "https://github.com/google-deepmind/alphafold",
      "install": "download the AF2 parameter bundle and the BFD/UniRef/MGnify databases into the AlphaFold data directory",
      "env": "OPERON_ALPHAFOLD_DATA",
      "roots": [
        "~/.local/share/operon/resources/alphafold2"
      ],
      "files": [
        "params/params_model_1_ptm.npz"
      ]
    },
    {
      "id": "rfdiffusion",
      "title": "RFdiffusion official checkout",
      "kind": "code+weights",
      "url": "https://github.com/RosettaCommons/RFdiffusion",
      "install": "git clone https://github.com/RosettaCommons/RFdiffusion.git && download the model weights into models/",
      "env": "OPERON_RFDIFFUSION_PATH",
      "roots": [
        "~/.local/share/operon/resources/rfdiffusion"
      ],
      "files": [
        "scripts/run_inference.py",
        "models/Complex_beta_ckpt.pt"
      ]
    },
    {
      "id": "prodigal",
      "title": "Prodigal gene predictor",
      "kind": "binary",
      "url": "https://github.com/hyattpd/Prodigal",
      "install": "conda install -c bioconda prodigal  (or build from the official source)",
      "env": "OPERON_PRODIGAL_PATH",
      "roots": [
        "/usr/local/bin",
        "/usr/bin",
        "~/.local/share/operon/resources/prodigal"
      ],
      "files": [
        "prodigal"
      ]
    },
    {
      "id": "pfam",
      "title": "Pfam-A HMM database",
      "kind": "database",
      "url": "https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz",
      "install": "curl -O https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz && gunzip Pfam-A.hmm.gz && hmmpress Pfam-A.hmm",
      "env": "OPERON_PFAM_HMM",
      "roots": [
        "~/.local/share/operon/resources/pfam"
      ],
      "files": [
        "Pfam-A.hmm"
      ]
    },
    {
      "id": "boltz",
      "title": "Boltz structure and affinity models",
      "kind": "weights",
      "url": "https://huggingface.co/boltz-community/boltz-1",
      "install": "python scripts/provision_resources.py --root <dir> --only boltz",
      "env": "OPERON_BOLTZ_CACHE",
      "roots": [
        "~/.local/share/operon/resources/boltz"
      ],
      "files": [
        "ccd.pkl",
        "boltz1_conf.ckpt"
      ],
      "downloads": {
        "ccd.pkl": "https://hf-mirror.com/boltz-community/boltz-1/resolve/main/ccd.pkl",
        "boltz1_conf.ckpt": "https://hf-mirror.com/boltz-community/boltz-1/resolve/main/boltz1_conf.ckpt"
      },
      "sha256": {
        "ccd.pkl": "2d3b2f03a3c5665944adba51e33263511e51b21c9cd05d902f9c4b7c1e58d2f4"
      },
      "sizes": {
        "ccd.pkl": 345859128,
        "boltz1_conf.ckpt": 3595352714
      }
    },
    {
      "id": "rfam",
      "title": "Rfam covariance models",
      "kind": "database",
      "url": "https://ftp.ebi.ac.uk/pub/databases/Rfam/CURRENT/Rfam.cm.gz",
      "install": "download Rfam.cm.gz, gunzip it, then run 'cmpress Rfam.cm' in the same directory",
      "env": "OPERON_RFAM_DB",
      "roots": [
        "~/.local/share/operon/resources/rfam"
      ],
      "files": [
        "Rfam.cm",
        "Rfam.cm.i1f",
        "Rfam.cm.i1i",
        "Rfam.cm.i1m",
        "Rfam.cm.i1p"
      ]
    },
    {
      "id": "amrfinder",
      "title": "AMRFinderPlus database",
      "kind": "database",
      "url": "https://ftp.ncbi.nlm.nih.gov/pathogen/Antimicrobial_resistance/AMRFinderPlus/database/latest/",
      "install": "amrfinder_update -d /path/to/amrfinder_db (installed with the amrfinder binary)",
      "env": "OPERON_AMRFINDER_DB",
      "roots": [
        "~/.local/share/operon/resources/amrfinder"
      ],
      "files": [
        "AMRProt.fa",
        "AMR.LIB",
        "AMRProt-mutation.tsv",
        "AMR_CDS.fa",
        "version.txt"
      ]
    },
    {
      "id": "antismash",
      "title": "antiSMASH module databases",
      "kind": "database",
      "url": "https://dl.secondarymetabolites.org/releases/",
      "install": "download-antismash-databases --database-dir /path/to/antismash_db (the conda package ships no databases)",
      "env": "OPERON_ANTISMASH_DB",
      "roots": [
        "~/.local/share/operon/resources/antismash"
      ],
      "files": [
        "mite/1.3/metadata.json",
        "resfam/Resfams.hmm",
        "tigrfam/TIGRFam.hmm"
      ]
    }
  ]
}
