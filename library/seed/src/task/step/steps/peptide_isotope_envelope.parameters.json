{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "peptide_dim": {
      "type": "string",
      "title": "Peptide dimension",
      "default": "peptide",
      "x-ui-group": "Dimensions"
    },
    "field_dim": {
      "type": "string",
      "title": "Field dimension",
      "default": "field",
      "x-ui-group": "Dimensions"
    },
    "max_peaks": {
      "type": "integer",
      "title": "Maximum peaks",
      "default": 4,
      "x-ui-group": "Isotopes",
      "minimum": 1,
      "maximum": 8
    },
    "charge": {
      "type": "integer",
      "title": "Charge state",
      "default": 1,
      "x-ui-group": "Isotopes",
      "minimum": 1,
      "maximum": 3
    },
    "output": {
      "type": "string",
      "title": "Output name",
      "default": "envelope",
      "x-ui-group": "Output"
    }
  },
  "additionalProperties": false
}
