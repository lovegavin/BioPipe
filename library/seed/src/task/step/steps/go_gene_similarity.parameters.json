{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GO gene semantic similarity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "obo_path": {
      "type": "string",
      "default": "workdir/b40_route/input/go-basic.obo"
    },
    "gaf_path": {
      "type": "string",
      "default": "workdir/b40_route/input/ecocyc.gaf.gz"
    },
    "aspect": {
      "type": "string",
      "enum": [
        "P",
        "F",
        "C",
        "all"
      ],
      "default": "P"
    },
    "output": {
      "type": "string",
      "default": "go_gene_similarity"
    },
    "pair_dim": {
      "type": "string",
      "default": "pair"
    },
    "field_dim": {
      "type": "string",
      "default": "field"
    },
    "pair_field": {
      "type": "string",
      "default": "pair"
    },
    "gene_a_field": {
      "type": "string",
      "default": "gene_a"
    },
    "gene_b_field": {
      "type": "string",
      "default": "gene_b"
    }
  }
}
