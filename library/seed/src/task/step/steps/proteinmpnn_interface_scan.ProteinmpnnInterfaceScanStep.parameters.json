{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "atom_dim": {
      "title": "原子维",
      "type": "string",
      "default": "atom",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "field_dim": {
      "title": "字段维",
      "type": "string",
      "default": "field",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "structure_path": {
      "title": "结构文件",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "binder_chains": {
      "title": "Binder 链",
      "type": "string",
      "default": "A",
      "x-ui-group": "输入",
      "x-ui-order": 4
    },
    "target_chains": {
      "title": "靶点链",
      "type": "string",
      "default": "B",
      "x-ui-group": "输入",
      "x-ui-order": 5
    },
    "cutoffs": {
      "title": "扫描截断",
      "type": "string",
      "default": "4.0,4.5,5.0",
      "x-ui-group": "扫描",
      "x-ui-order": 1
    },
    "min_contacts": {
      "title": "最少接触",
      "type": "integer",
      "default": 1,
      "x-ui-group": "扫描",
      "x-ui-order": 2,
      "minimum": 1,
      "maximum": 50
    },
    "top_n": {
      "title": "热点数上限",
      "type": "integer",
      "default": 0,
      "x-ui-group": "扫描",
      "x-ui-order": 3,
      "minimum": 0,
      "maximum": 200
    },
    "num_seq_per_target": {
      "title": "每条序列数",
      "type": "integer",
      "default": 8,
      "x-ui-group": "设计",
      "x-ui-order": 1,
      "minimum": 1,
      "maximum": 100
    },
    "sampling_temp": {
      "title": "采样温度",
      "type": "string",
      "default": "0.1",
      "x-ui-group": "设计",
      "x-ui-order": 2
    },
    "seed": {
      "title": "随机种子",
      "type": "integer",
      "default": 1,
      "x-ui-group": "设计",
      "x-ui-order": 3
    },
    "model_name": {
      "title": "模型",
      "type": "string",
      "default": "v_48_020",
      "x-ui-group": "设计",
      "x-ui-order": 4,
      "enum": [
        "v_48_002",
        "v_48_010",
        "v_48_020",
        "v_48_030"
      ]
    },
    "proteinmpnn_path": {
      "title": "ProteinMPNN 目录",
      "type": "string",
      "default": "~/.operon/resources/proteinmpnn",
      "x-ui-group": "依赖",
      "x-ui-order": 1
    },
    "weights_path": {
      "title": "权重目录",
      "type": "string",
      "default": "",
      "x-ui-group": "依赖",
      "x-ui-order": 2
    },
    "python_executable": {
      "title": "Python 解释器",
      "type": "string",
      "default": "python3",
      "x-ui-group": "依赖",
      "x-ui-order": 3
    },
    "device": {
      "title": "设备",
      "type": "string",
      "default": "cpu",
      "x-ui-group": "依赖",
      "x-ui-order": 4,
      "enum": [
        "cpu",
        "cuda"
      ]
    },
    "timeout": {
      "title": "超时 (s)",
      "type": "integer",
      "default": 1800,
      "x-ui-group": "依赖",
      "x-ui-order": 5,
      "minimum": 30,
      "maximum": 7200
    },
    "output": {
      "title": "输出",
      "type": "string",
      "default": "scan",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
