{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "title": "MM/GBSA 结合能估计",
  "description": "用 OpenMM 单点计算复合物、结合方与靶方的势能差，并按键合/非键/GB 项分解。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "atom_dim": {
      "title": "原子维度",
      "type": "string",
      "default": "atom",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "field_dim": {
      "title": "字段维度",
      "type": "string",
      "default": "field",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "binder_chains": {
      "title": "结合方链",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "target_chains": {
      "title": "靶方链",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 4
    },
    "forcefield": {
      "title": "力场文件",
      "type": "string",
      "default": "amber14-all.xml",
      "x-ui-group": "模型",
      "x-ui-order": 1
    },
    "implicit_model": {
      "title": "隐式溶剂",
      "type": "string",
      "default": "implicit/gbn2.xml",
      "x-ui-group": "模型",
      "x-ui-order": 2
    },
    "ph": {
      "title": "质子化 pH",
      "type": "number",
      "default": 7.0,
      "minimum": 0.1,
      "maximum": 13.9,
      "x-ui-group": "模型",
      "x-ui-order": 3
    },
    "term_dim": {
      "title": "能量项维度",
      "type": "string",
      "default": "term",
      "x-ui-group": "输出",
      "x-ui-order": 1
    },
    "output": {
      "title": "输出参数",
      "type": "string",
      "default": "energy",
      "x-ui-group": "输出",
      "x-ui-order": 2
    }
  }
}
