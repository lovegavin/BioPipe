{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sample_dim": {
      "title": "样本维",
      "type": "string",
      "default": "sequence",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "feature_dim": {
      "title": "特征维",
      "type": "string",
      "default": "embedding",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "n_estimators": {
      "title": "树数量",
      "type": "integer",
      "default": 100,
      "x-ui-group": "模型",
      "x-ui-order": 1,
      "minimum": 10,
      "maximum": 1000
    },
    "contamination": {
      "title": "异常比例",
      "type": "number",
      "default": 0.1,
      "x-ui-group": "模型",
      "x-ui-order": 2,
      "minimum": 0.01,
      "maximum": 0.5
    },
    "random_state": {
      "title": "随机种子",
      "type": "integer",
      "default": 0,
      "x-ui-group": "模型",
      "x-ui-order": 3
    },
    "output": {
      "title": "输出",
      "type": "string",
      "default": "novelty",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
