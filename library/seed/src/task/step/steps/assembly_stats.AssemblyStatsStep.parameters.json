{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "title": "组装质控参数",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "title": "序列维度",
      "type": "string",
      "default": "sequence",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "position_dim": {
      "title": "位置维度",
      "type": "string",
      "default": "position",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "reference_path": {
      "title": "参考基因组 (可选)",
      "type": "string",
      "default": "",
      "x-ui-group": "输入",
      "x-ui-order": 3
    },
    "min_contig": {
      "title": "最小 contig 长度",
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 1000000,
      "x-ui-group": "质控",
      "x-ui-order": 1
    },
    "threads": {
      "title": "线程数",
      "type": "integer",
      "default": 4,
      "minimum": 1,
      "maximum": 128,
      "x-ui-group": "质控",
      "x-ui-order": 2
    },
    "quast_path": {
      "title": "QUAST 可执行文件",
      "type": "string",
      "default": "quast",
      "x-ui-group": "依赖",
      "x-ui-order": 1
    },
    "timeout_seconds": {
      "title": "超时 (秒)",
      "type": "integer",
      "default": 900,
      "minimum": 30,
      "maximum": 86400,
      "x-ui-group": "依赖",
      "x-ui-order": 2
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "metrics",
      "x-ui-group": "输出",
      "x-ui-order": 1
    }
  }
}
