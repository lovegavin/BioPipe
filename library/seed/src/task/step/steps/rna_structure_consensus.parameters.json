{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "rna_structure_consensus",
  "properties": {
    "sequence_dim": {
      "type": "string",
      "default": "sequence",
      "title": "Sequence axis"
    },
    "position_dim": {
      "type": "string",
      "default": "position",
      "title": "Position axis"
    },
    "temperature": {
      "type": "number",
      "default": 37.0,
      "minimum": 0.0,
      "maximum": 100.0,
      "title": "Temperature (C)"
    },
    "dangles": {
      "type": "integer",
      "default": 2,
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "Dangling ends"
    },
    "rnafold_path": {
      "type": "string",
      "default": "RNAfold",
      "title": "RNAfold binary"
    },
    "timeout_seconds": {
      "type": "integer",
      "default": 600,
      "minimum": 1,
      "title": "Timeout (s)"
    },
    "sequence_output_dim": {
      "type": "string",
      "default": "sequence",
      "title": "Output sequence axis"
    },
    "output": {
      "type": "string",
      "default": "consensus",
      "title": "Output name"
    },
    "energy_window": {
      "type": "number",
      "default": 3.0,
      "minimum": 0.0,
      "maximum": 50.0,
      "title": "Energy window (kcal/mol)"
    },
    "max_structures": {
      "type": "integer",
      "default": 20,
      "minimum": 2,
      "maximum": 1000,
      "title": "Maximum structures"
    },
    "threshold": {
      "type": "number",
      "default": 0.5,
      "minimum": 0.0,
      "maximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Pair probability threshold"
    },
    "rnasubopt_path": {
      "type": "string",
      "default": "RNAsubopt",
      "title": "RNAsubopt binary"
    }
  },
  "required": [
    "sequence_dim",
    "position_dim",
    "temperature",
    "dangles",
    "rnafold_path",
    "timeout_seconds",
    "sequence_output_dim",
    "output",
    "energy_window",
    "max_structures",
    "threshold",
    "rnasubopt_path"
  ],
  "additionalProperties": false
}
