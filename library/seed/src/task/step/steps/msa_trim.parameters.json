{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Alignment trimming parameters",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "type": "string",
      "default": "sequence",
      "description": "Name of the sequence axis."
    },
    "position_dim": {
      "type": "string",
      "default": "position",
      "description": "Name of the alignment position axis."
    },
    "max_gap_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "description": "Columns with a larger gap fraction are removed."
    },
    "min_row_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "description": "Rows covering less of the retained columns are removed."
    },
    "output": {
      "type": "string",
      "default": "trimmed",
      "description": "Name of the output artifact."
    }
  }
}
