{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "title": "Boltz 复合物置信度参数",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sequence_dim": {
      "title": "序列维度",
      "type": "string",
      "default": "sequence",
      "x-ui-group": "输入",
      "x-ui-order": 1
    },
    "position_dim": {
      "title": "位点维度",
      "type": "string",
      "default": "position",
      "x-ui-group": "输入",
      "x-ui-order": 2
    },
    "boltz_path": {
      "title": "Boltz 可执行文件",
      "type": "string",
      "default": "boltz",
      "x-ui-group": "依赖",
      "x-ui-order": 1
    },
    "cache_dir": {
      "title": "权重缓存目录",
      "type": "string",
      "default": "",
      "x-ui-group": "依赖",
      "x-ui-order": 2
    },
    "model": {
      "title": "模型",
      "type": "string",
      "default": "boltz2",
      "enum": [
        "boltz1",
        "boltz2"
      ],
      "x-ui-group": "模型",
      "x-ui-order": 1
    },
    "device": {
      "title": "设备",
      "type": "string",
      "default": "cpu",
      "enum": [
        "cpu",
        "cuda"
      ],
      "x-ui-group": "模型",
      "x-ui-order": 2
    },
    "sampling_steps": {
      "title": "采样步数",
      "type": "integer",
      "default": 50,
      "minimum": 10,
      "maximum": 500,
      "x-ui-group": "模型",
      "x-ui-order": 3
    },
    "diffusion_samples": {
      "title": "扩散样本数",
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 8,
      "x-ui-group": "模型",
      "x-ui-order": 4
    },
    "interface_cutoff": {
      "title": "界面距离阈值 (Å)",
      "type": "number",
      "default": 8.0,
      "minimum": 3.0,
      "maximum": 20.0,
      "x-ui-group": "检测",
      "x-ui-order": 1
    },
    "timeout_seconds": {
      "title": "超时 (秒)",
      "type": "integer",
      "default": 3600,
      "minimum": 60,
      "maximum": 7200,
      "x-ui-group": "依赖",
      "x-ui-order": 3
    },
    "report_dim": {
      "title": "输出维度",
      "type": "string",
      "default": "residue",
      "x-ui-group": "输出",
      "x-ui-order": 1
    },
    "output": {
      "title": "输出参数名",
      "type": "string",
      "default": "confidence",
      "x-ui-group": "输出",
      "x-ui-order": 2
    }
  }
}
