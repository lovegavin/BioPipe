{
  "missing": {
    "title": "缺失值过滤",
    "category": "质量控制",
    "description": "按指定维度过滤缺失比例过高的样本或特征。",
    "icon": "Funnel",
    "parameters": [
      {
        "key": "dim",
        "label": "过滤维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "threshold",
        "label": "最大缺失比例",
        "type": "number",
        "default": 0.05,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "required": true
      }
    ]
  },
  "maf": {
    "title": "MAF",
    "title_aliases": ["等位基因频率"],
    "category": "质量控制",
    "description": "过滤低频变异。输入需要基因型及 ploidy 元数据。",
    "icon": "Dna",
    "parameters": [
      {
        "key": "dim",
        "label": "变异维度",
        "type": "string",
        "default": "variant",
        "required": true
      },
      {
        "key": "threshold",
        "label": "最低 MAF",
        "type": "number",
        "default": 0.05,
        "min": 0,
        "max": 0.5,
        "step": 0.01
      }
    ]
  },
  "hwe": {
    "title": "HWE",
    "title_aliases": ["平衡检验"],
    "category": "质量控制",
    "description": "Hardy–Weinberg 平衡过滤。输入需要二倍体基因型。",
    "icon": "Scales",
    "parameters": [
      {
        "key": "dim",
        "label": "变异维度",
        "type": "string",
        "default": "variant",
        "required": true
      },
      {
        "key": "threshold",
        "label": "最低 P 值",
        "type": "number",
        "default": 0.0001,
        "min": 0,
        "max": 1,
        "step": 0.0001
      }
    ]
  },
  "ld_prune": {
    "title": "LD pruning",
    "title_aliases": ["连锁不平衡剪枝"],
    "category": "质量控制",
    "description": "在滑动窗口内移除高度相关的变异。",
    "icon": "Intersect",
    "parameters": [
      {
        "key": "dim",
        "label": "变异维度",
        "type": "string",
        "default": "variant",
        "required": true
      },
      {
        "key": "window",
        "label": "窗口大小",
        "type": "integer",
        "default": 50,
        "min": 1
      },
      {
        "key": "r2",
        "label": "R² 阈值",
        "type": "number",
        "default": 0.2,
        "min": 0,
        "max": 1,
        "step": 0.05
      }
    ]
  },
  "pca": {
    "title": "PCA",
    "title_aliases": ["主成分分析"],
    "category": "统计分析",
    "description": "标准化数据，提取主成分；缺失值以特征均值填充。",
    "icon": "ChartScatter",
    "output_type": "Scores",
    "parameters": [
      {
        "key": "dim",
        "label": "压缩维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "n_components",
        "label": "主成分数量",
        "type": "integer",
        "default": 2,
        "min": 1,
        "required": true
      }
    ]
  },
  "regress": {
    "title": "回归分析",
    "category": "统计分析",
    "description": "逐个特征拟合回归模型，可加入协变量。",
    "icon": "TrendUp",
    "output_type": "Association",
    "parameters": [
      {
        "key": "dim",
        "label": "特征维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "response",
        "label": "响应变量标签",
        "type": "string",
        "default": "trait",
        "required": true
      },
      {
        "key": "covariates",
        "label": "协变量标签",
        "type": "list",
        "default": []
      },
      {
        "key": "method",
        "label": "模型",
        "type": "choice",
        "default": "auto",
        "options": [
          "auto",
          "ols",
          "logit"
        ]
      }
    ]
  },
  "correction": {
    "title": "FDR",
    "title_aliases": ["多重检验校正"],
    "title_parameter": {"key": "method", "values": {"fdr": "FDR", "bonferroni": "Bonferroni"}},
    "category": "统计分析",
    "description": "进行 Bonferroni 或 FDR 校正。",
    "icon": "CheckSquare",
    "output_type": "Association",
    "parameters": [
      {
        "key": "method",
        "label": "校正方法",
        "type": "choice",
        "default": "fdr",
        "options": [
          "fdr",
          "bonferroni"
        ]
      },
      {
        "key": "alpha",
        "label": "显著性水平",
        "type": "number",
        "default": 0.05,
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "key": "pfield",
        "label": "P 值标签",
        "type": "string",
        "default": "P"
      },
      {
        "key": "dim",
        "label": "统计量维度",
        "type": "string",
        "default": "statistic"
      }
    ]
  },
  "describe": {
    "title": "数据概览",
    "category": "数据整理",
    "description": "查看形状、标签、缺失情况与全局统计。支持分块读取。",
    "icon": "ListBullets",
    "output_type": "Report",
    "parameters": []
  },
  "select": {
    "title": "选择特征",
    "category": "数据整理",
    "description": "按标签选择样本或特征。",
    "icon": "Selection",
    "parameters": [
      {
        "key": "dim",
        "label": "选择维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "labels",
        "label": "保留的标签",
        "type": "list",
        "default": [
          "f0",
          "f1"
        ],
        "required": true
      }
    ]
  },
  "drop": {
    "title": "移除特征",
    "category": "数据整理",
    "description": "移除指定维度上的标签。",
    "icon": "MinusSquare",
    "parameters": [
      {
        "key": "dim",
        "label": "移除维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "labels",
        "label": "移除的标签",
        "type": "list",
        "default": [
          "f0"
        ],
        "required": true
      }
    ]
  },
  "transpose": {
    "title": "维度转置",
    "category": "数据整理",
    "description": "调整命名维度的排列顺序。",
    "icon": "ArrowsDownUp",
    "parameters": [
      {
        "key": "order",
        "label": "维度顺序",
        "type": "list",
        "default": [
          "feature",
          "sample"
        ],
        "required": true
      }
    ]
  },
  "rename_dim": {
    "title": "重命名维度",
    "category": "数据整理",
    "description": "为一个维度更换名称。",
    "icon": "TextT",
    "parameters": [
      {
        "key": "from",
        "label": "原维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "to",
        "label": "新维度",
        "type": "string",
        "default": "variant",
        "required": true
      }
    ]
  },
  "concat": {
    "title": "合并数据",
    "category": "数据整理",
    "description": "按指定维度连接多个输入，输入端口顺序决定合并顺序。",
    "icon": "Unite",
    "parameters": [
      {
        "key": "axis",
        "label": "合并维度",
        "type": "string",
        "default": "feature",
        "required": true
      }
    ]
  },
  "attach_info": {
    "title": "附加注释",
    "category": "数据整理",
    "description": "输入 1 为目标数据，输入 2 为注释来源。",
    "icon": "Tag",
    "parameters": [
      {
        "key": "fields",
        "label": "注释字段",
        "type": "list",
        "default": [
          "chrom",
          "pos"
        ],
        "required": true
      },
      {
        "key": "target_dim",
        "label": "目标维度",
        "type": "string",
        "default": "feature",
        "required": true
      }
    ]
  },
  "scatter": {
    "title": "散点图",
    "category": "可视化",
    "description": "选择两个标签绘制散点图。",
    "icon": "ChartScatter",
    "output_type": "Figure",
    "parameters": [
      {
        "key": "dim",
        "label": "坐标维度",
        "type": "string",
        "default": "component",
        "required": true
      },
      {
        "key": "x_label",
        "label": "横坐标标签",
        "type": "string",
        "default": "PC1",
        "required": true
      },
      {
        "key": "y_label",
        "label": "纵坐标标签",
        "type": "string",
        "default": "PC2",
        "required": true
      },
      {
        "key": "filename",
        "label": "文件名",
        "type": "string",
        "default": "scatter.png",
        "required": true
      }
    ]
  },
  "histogram": {
    "title": "直方图",
    "category": "可视化",
    "description": "查看指定数值标签的分布。",
    "icon": "ChartBar",
    "output_type": "Figure",
    "parameters": [
      {
        "key": "dim",
        "label": "数值维度",
        "type": "string",
        "default": "statistic",
        "required": true
      },
      {
        "key": "value_label",
        "label": "数值标签",
        "type": "string",
        "default": "P",
        "required": true
      },
      {
        "key": "bins",
        "label": "分箱数量",
        "type": "integer",
        "default": 20,
        "min": 1
      },
      {
        "key": "filename",
        "label": "文件名",
        "type": "string",
        "default": "histogram.png",
        "required": true
      }
    ]
  },
  "line": {
    "title": "折线图",
    "category": "可视化",
    "description": "选择两个数值标签，按横坐标排序后绘制曲线。",
    "icon": "ChartLine",
    "output_type": "Figure",
    "parameters": [
      {
        "key": "dim",
        "label": "维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "x_label",
        "label": "横坐标标签",
        "type": "string",
        "default": "f0",
        "required": true
      },
      {
        "key": "y_label",
        "label": "纵坐标标签",
        "type": "string",
        "default": "f1",
        "required": true
      },
      {
        "key": "filename",
        "label": "文件名",
        "type": "string",
        "default": "line.png",
        "required": true
      }
    ]
  },
  "manhattan": {
    "title": "曼哈顿图",
    "category": "可视化",
    "description": "用染色体、位置和 P 值绘制关联结果。",
    "icon": "ChartBar",
    "output_type": "Figure",
    "parameters": [
      {
        "key": "dim",
        "label": "变异维度",
        "type": "string",
        "default": "feature",
        "required": true
      },
      {
        "key": "chrom_label",
        "label": "染色体字段",
        "type": "string",
        "default": "chrom",
        "required": true
      },
      {
        "key": "pos_label",
        "label": "位置字段",
        "type": "string",
        "default": "pos",
        "required": true
      },
      {
        "key": "p_dim",
        "label": "统计量维度",
        "type": "string",
        "default": "statistic"
      },
      {
        "key": "p_label",
        "label": "P 值标签",
        "type": "string",
        "default": "P",
        "required": true
      },
      {
        "key": "filename",
        "label": "文件名",
        "type": "string",
        "default": "manhattan.png",
        "required": true
      }
    ]
  }
}
